17:["$","section",null,{"className":"section service-sections","children":[["$","div","who",{"children":[["$","p",null,{"className":"section-label","children":"Для кого и когда"}],["$","p",null,{"children":"Инвесторы и собственники, которым важно увидеть экономику до серьёзных вложений."}]]}],["$","div","gets",{"children":[["$","p",null,{"className":"section-label","children":"Что в результате?"}],["$","p",null,{"children":"Прозрачную модель с вариантами развития, точками риска и условиями жизнеспособности."}]]}],["$","div","how",{"children":[["$","p",null,{"className":"section-label","children":"Как работаем"}],["$","p",null,{"children":"Собираем допущения. Считаем несколько сценариев. Не сглаживаем цифры ради комфорта."}]]}],["$","div","why",{"children":[["$","p",null,{"className":"section-label","children":"Почему это важно"}],["$","p",null,{"children":"Красивая архитектура без рабочей экономики быстро перестаёт радовать."}]]}],["$","div","next",{"children":[["$","p",null,{"className":"section-label","children":"Формат и следующий шаг"}],["$","p",null,{"children":"Модель с пояснениями. Затем уточнение концепции, параметров объекта или решение об инвестировании."}]]}]]}]
18:["$","article",null,{"className":"marketing-chapter","id":"brand","children":[["$","section",null,{"className":"page-intro service-lead","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"02"}],["$","h2",null,{"children":"Бренд-стратегия: аудит и разработка"}],["$","p",null,{"className":"service-essence","children":"Поможем выстроить смысловую платформу вашего проекта и стратегию его представления на рынке."}]]}],["$","aside",null,{"className":"service-lead-aside service-lead-stack","children":[["$","figure",null,{"children":[["$","$L10",null,{"src":"/site-AB-IM/pr-18/assets/brand-voice.mp4","poster":"/site-AB-IM/pr-18/assets/finance-voice.jpg"}],["$","figcaption",null,{"className":"service-lead-sign","children":["Михаил Лункин",["$","span",null,{"children":"маркетолог бюро"}]]}]]}],["$","blockquote",null,{"children":"Говорят, что нужно быть, а не казаться. Всё так. Но казаться тоже надо уметь. Даже если у вас золото: любой товар важно уметь представить лицом. Мы помогаем любое дело превратить в продукт и сформировать на него платежеспособный спрос."}]]}]]}],["$","section",null,{"className":"finance-method brand-method","children":["$","h2",null,{"children":"Как это делаем мы"}]}],["$","div",null,{"className":"brand-path","children":[["$","p",null,{"className":"brand-creed","children":[["$","span",null,{"children":"Вы творите."}],["$","span",null,{"children":"Мы изучаем, ограняем, укрепляем, воспеваем и продвигаем."}]]}],["$","ol",null,{"className":"brand-steps","children":[["$","li","01",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Аудит"}],["$","p",null,{"children":"Изучаем ценностное предложение, смотрим, насколько далеко ваше обещание можно развернуть, не выдумав того, чего нет. Ищем на рынке целевой сегмент, смотрим окружение, считаем, какая цена делает дело интересным для всех. Мы не пытаемся обойти всех, скорее мы стараемся не заговорить чужим голосом."}]]}]]}],["$","li","02",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Портфель"}],["$","p",null,{"children":"Продукт — рыночное оружие. Так у любого дела. Из потенциала, который есть на самом деле, собираем, что можно выставить. И сразу намечаем, как этот потенциал растить, чтобы он дотягивал до целей. На любом горизонте."}]]}]]}],["$","li","03",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Цели"}],["$","p",null,{"children":"Иногда цель уже названа, и мы проверяем, хватает ли на неё потенциала. Иногда ставим её вместе. Цели женим с продуктами и с ресурсами, в том числе с тем, как здесь вообще считаются деньги. Все должны одинаково понимать, куда идут, зачем, и трезво оценивать возможности и угрозы."}]]}]]}],["$","li","04",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Стратегия"}],["$","p",null,{"children":"Коктейль из метода, способа и плана. Такой, который все стороны без оговорок принимают за эталон вкуса и гармонии. Задача непростая. Когда берёмся — решаем."}]]}]]}],["$","li","05",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"05"}],["$","div",null,{"children":[["$","h3",null,{"children":"До результата"}],["$","p",null,{"children":"Если стратегия принята и в ней нужна наша помощь, мы будем работать. Коммуникации, сайт, СМИ, дизайн — любые маркетинговые задачи. Поможем пройти весь путь. Вы творите замысел. Мы его держим."}]]}]]}]]}],["$","section",null,{"className":"brand-close","children":[["$","h2",null,{"children":"Сначала место."}],["$","p",null,{"children":["Прежде всего — мы архитектурное бюро. Обычно мы берёмся за маркетинг тогда, когда проектируем или ведём какую-то стройку: опыт начинается с места, а не с объявления. Чаще всего это ",["$","a",null,{"href":"/site-AB-IM/pr-18/#directions","children":"живое гостеприимство"}],", хотя бывает и другое. Если вам нужна помощь — приходите, договоримся."]}],"$L1a"]}],"$L1b"]}],"$L1c","$L1d"]}]
19:["$","article",null,{"className":"marketing-chapter","id":"comms","children":[["$","section",null,{"className":"page-intro","children":[["$","p",null,{"className":"section-label","children":"03"}],["$","h2",null,{"children":"Коммуникационная стратегия"}],["$","p",null,{"className":"service-essence","children":"Система целей, сообщений, каналов и способов измерения. Коммуникации растут из сути проекта и бренда, а не живут отдельно."}]]}],["$","section",null,{"className":"section service-sections","children":[["$","div","who",{"children":[["$","p",null,{"className":"section-label","children":"Для кого и когда"}],["$","p",null,{"children":"Предприниматели, которым нужна управляемость интереса к проекту — на старте или когда активности уже есть, но нет общей логики."}]]}],["$","div","gets",{"children":[["$","p",null,{"className":"section-label","children":"Что в результате?"}],["$","p",null,{"children":"Рамку: что говорить, кому, через какие каналы и как понимать, что это работает."}]]}],["$","div","how",{"children":[["$","p",null,{"className":"section-label","children":"Как работаем"}],["$","p",null,{"children":"Аудит коммуникаций, если они есть. Собираем цели, сообщения и логику каналов. При необходимости сопровождаем исполнение."}]]}],["$","div","why",{"children":[["$","p",null,{"className":"section-label","children":"Почему это важно"}],["$","p",null,{"children":"Разрозненные коммуникации быстро теряют силу и бюджет."}]]}],["$","div","next",{"children":[["$","p",null,{"className":"section-label","children":"Формат и следующий шаг"}],["$","p",null,{"children":"Стратегия с планом действий. Затем последовательное исполнение, а не разовые акции."}]]}]]}]]}]
