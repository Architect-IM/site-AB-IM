1:["$","main",null,{"id":"content","className":"inner-page bureau-page service-page","children":[["$","section",null,{"className":"page-intro marketing-intro","children":[["$","h1",null,{"children":"Маркетинг"}],["$","p",null,{"className":"service-essence","children":"Если вы еще находитесь на этапе формирования, уточнения или даже пересмотра маркетинговой стратегии - мы можем помочь вам принять верные решения, увязав их с проектными решениями будущего строительства. Только для клиентов бюро."}]]}],["$","nav",null,{"className":"marketing-nav","aria-label":"Разделы","children":[["$","a",null,{"href":"#finance","children":[["$","span",null,{"children":"01"}],"Финансово-экономическое моделирование"]}],["$","a",null,{"href":"#brand","children":[["$","span",null,{"children":"02"}],"Бренд-стратегия: аудит и разработка"]}],["$","a",null,{"href":"#comms","children":[["$","span",null,{"children":"03"}],"Коммуникационная стратегия"]}]]}],["$","article",null,{"className":"marketing-chapter","id":"finance","children":[["$","section",null,{"className":"page-intro service-lead","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"01"}],["$","h2",null,{"children":"Финансово-экономическое моделирование"}],["$","p",null,{"className":"service-essence","children":"Расчёт проекта в деньгах с разными сценариями."}]]}],["$","aside",null,{"className":"service-lead-aside","children":[["$","figure",null,{"children":[["$","$L10",null,{"src":"/site-AB-IM/pr-18/assets/finance-voice.mp4","poster":"/site-AB-IM/pr-18/assets/finance-voice.jpg"}],["$","figcaption",null,{"className":"service-lead-sign","children":["Михаил Лункин",["$","span",null,{"children":"маркетолог бюро"}]]}]]}],["$","blockquote",null,{"children":"Мы не собираем максимально полную модель и без нужды не подгоняем её под МСФО и другие стандарты, а скорее помогаем сделать первый шаг к будущему подробному учёту. Вместе ответим на вопросы — как здесь вообще считаются деньги, как создаётся добавленная стоимость и как на это влияют проектные решения. Разбираем разные сценарии, чтобы было видно, что живёт, а где деньги не возвращаются."}]]}]]}],["$","section",null,{"className":"finance-method","children":[["$","h2",null,{"children":"Как это делается"}],["$","p",null,{"children":"Мы проводим все необходимые интервью и расчёты: что за объект, какие решения уже есть, откуда берутся деньги и доход. Потом собираем все цифры в таблицы, перепроверяем их на достоверность и полноту. После этого показываем результат инфографикой на закрытом сайте проекта, который мы делаем для каждого заказчика и храним там этот архив всех данных по его проекту."}],["$","p",null,{"className":"finance-method-next","children":"Ниже — пример."}]]}],["$","$L11",null,{}],["$","div",null,{"className":"finance-record","children":[["$","section",null,{"className":"finance-block finance-split","children":[["$","div",null,{"className":"finance-video","children":[["$","video",null,{"src":"/site-AB-IM/pr-18/assets/finance-session.mp4","poster":"/site-AB-IM/pr-18/assets/resort.jpg","muted":true,"loop":true,"autoPlay":true,"playsInline":true}],["$","span",null,{"children":"0:30 · запись рабочей сессии бюро"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Разбор"}],["$","h2",null,{"children":"Три сценария, не один прогноз"}],["$","p",null,{"children":"Как читаем допущения, где ломается «красивый» год и что из этого следует для объёма."}]]}]]}],["$","section",null,{"className":"finance-block finance-split","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/mansion.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Один ход"}],["$","h2",null,{"children":"Не строили второй объём"}],["$","p",null,{"children":"Заказчик держал береговой комплекс как «якорь территории»: два корпуса, ресторан, баня. Базовый сценарий ещё дышал. Осторожный — нет: заполняемость в межсезонье не несла второй объём, инженерия и берегоукрепление съедали запас. Сняли второй корпус на модели, до того как он появился на площадке. Первый объём пересобрали: меньше номеров, выше счёт с гостя, общий двор вместо второго дома."}],"$L12"]}]]}],"$L13","$L14","$L15","$L16"]}],"$L17"]}],"$L18","$L19"]}]
12:["$","p",null,{"className":"finance-fact","children":"Срок возврата 7,5 → 6,2. Второй объём остался в резерве земли, не в бетоне."}]
13:["$","section",null,{"className":"finance-block finance-who","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Кому это нужно"}],["$","p",null,{"children":"Собственник или инвестор до серьёзных вложений. Когда уже есть идея или эскиз и хочется увидеть, живёт ли объект как дело — не как картинка."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Кому нет"}],["$","p",null,{"children":"Кто ищет обоснование уже принятого решения. Кто просит «сделать красивую доходность для банка» без права менять программу. Это не наша работа."}]]}]]}]
14:["$","section",null,{"className":"finance-quote","children":[["$","blockquote",null,{"children":"Нам было неприятно увидеть осторожный сценарий. И правильно: мы не вывели на берег второй корпус, который кормили бы из кармана."}],["$","p",null,{"children":"Управляющий партнёр, туристический комплекс, Владимирская область"}]]}]
15:["$","section",null,{"className":"finance-block","children":[["$","p",null,{"className":"section-label","children":"Паспорт услуги"}],["$","dl",null,{"className":"finance-passport","children":[["$","div","Как работаем",{"children":[["$","dt",null,{"children":"Как работаем"}],["$","dd",null,{"children":"Собираем допущения. Считаем несколько сценариев. Не сглаживаем цифры ради комфорта."}]]}],["$","div","Почему это важно",{"children":[["$","dt",null,{"children":"Почему это важно"}],["$","dd",null,{"children":"Красивая архитектура без рабочей экономики быстро перестаёт радовать."}]]}],["$","div","Формат и следующий шаг",{"children":[["$","dt",null,{"children":"Формат и следующий шаг"}],["$","dd",null,{"children":"Модель с пояснениями. Затем уточнение концепции, параметров объекта или решение об инвестировании."}]]}]]}]]}]
