1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/gostec/01.jpg","alt":"Дома на лугу"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Гостиница · Гостец"}],["$","h1",null,{"children":"Гостиница Гостец"}],["$","p",null,{"className":"pp-hero-quote","children":["— ","Тёмные дома с крутыми кровлями держат луг."]}]]}]]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"Гостец"}],["$","h2",null,{"children":"Посёлок, который не разбежался."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"Гостец — несколько тёмных домов с крутыми кровлями. Они стоят группой на лугу, между деревьями, не вдоль забора."}],["$","p",null,{"children":"Есть общий путь, есть двор, есть виды сверху, где видно, как дома обходят деревья, а не вырубают под себя площадку."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/gostec/02.jpg","alt":"Группа корпусов"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"Островерхие кровли легко превратить в декорацию «шале». Здесь они нужны, чтобы дома читались издали и не расползались по лугу. Тёмный фасад сажает их в зелень, а не выбеливает на фоне неба."}]]}]]}],null,["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/gostec/04.jpg","alt":"Вид сверху"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Сверху"}],["$","h2",null,{"children":"Деревья остаются в плане."}],["$","p",null,{"children":"Вид сверху показывает то, чего не видно с дорожки: дома обходят кроны. Бассейн и дворы встроены между корпусами, а не вынесены «зоной отдыха» за забор."}]]}]]}],["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Гостиничный посёлок."}],["$","p",null,{"className":"pp-facts","children":"Гостец · луг · проект"}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/gostec/03.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"children":"Группа домов, общие пути, кровли одного характера. Задача — чтобы посёлок выглядел собранным и при этом не съел луг."}],["$","p",null,{"className":"pp-line","children":["— ","Дома стоят среди деревьев. Не вместо них."]}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article","Кровля",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Кровля"}],["$","p",null,{"children":"Один характер крыш собирает разные корпуса в одно место."}]]}],["$","article","Луг",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Луг"}],["$","p",null,{"children":"Дорожки идут по земле, а не по асфальтовому пандусу."}]]}],["$","article","Двор",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Двор"}],["$","p",null,{"children":"Общие места между домами, не отдельный «спа-корпус» в поле."}]]}]]}],["$","a",null,{"className":"next-project","href":"/site-AB-IM/pr-18/portfolio/sokol","children":[["$","span",null,{"className":"section-label","children":"Следующий проект"}],["$","span",null,{"children":"Гостиница сокол"}],["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/sokol/01.jpg","alt":"","loading":"lazy"}]]}]]}]
