1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/dobrograd/01.jpg","alt":"Квартал Доброграда зимой"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Заказчик · Доброград"}],["$","h1",null,{"children":"Доброград"}],["$","p",null,{"className":"pp-hero-quote","children":["— ","Кирпич и дерево, которые уже стоят на снегу."]}]]}]]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"Доброград"}],["$","h2",null,{"children":"Квартал, а не один красивый дом."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"В Доброграде дома стоят группой. Кирпич, дерево, плоские кровли, дворы между корпусами. Зимой это читается особенно ясно: снег показывает, где объём, а где пустота."}],["$","p",null,{"children":"Рядом вода и длинный стеклянный павильон. Квартал не заканчивается фасадом. Он выходит к берегу."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/dobrograd/02.jpg","alt":"Корпуса у снега"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"Мне важно, что это уже построено. Не картинка, которую ещё предстоит оправдать. Кирпич и дерево держат квартал и зимой, и летом. Вода не декорация сбоку, а край, к которому квартал повёрнут."}]]}]]}],null,["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/dobrograd/04.jpg","alt":"Ресторан"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Уже стоит"}],["$","h2",null,{"children":"Снег не прячет дом."}],["$","p",null,{"children":"Зимние кадры показывают то же, что летние: корпуса собраны в группу, въезды короткие, двор общий. Отдельно — реконструкция ресторана. Общественное место в том же материале, без попытки выглядеть «главным зданием»."}]]}]]}],["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Построенный квартал."}],["$","p",null,{"className":"pp-facts","children":"Доброград · кирпич и дерево · стоит"}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/dobrograd/03.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"children":"Задача была не нарисовать одинокий коттедж, а собрать дома так, чтобы они держали друг друга. Общий двор, короткие въезды, берег как продолжение квартала. Ресторан — отдельный ход, но из того же языка."}],["$","p",null,{"className":"pp-line","children":["— ","Место уже живёт. Архитектура это не обещает, а подтверждает."]}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article","Группа",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Группа"}],["$","p",null,{"children":"Дома не разъехались по участку. Они стоят вместе и делают двор."}]]}],["$","article","Материал",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Материал"}],["$","p",null,{"children":"Кирпич и дерево не спорят. Один держит массу, другой — тепло фасада."}]]}],["$","article","Берег",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Берег"}],["$","p",null,{"children":"Вода и стеклянный павильон заканчивают квартал, а не висят открыткой сбоку."}]]}]]}],["$","a",null,{"className":"next-project","href":"/site-AB-IM/pr-18/portfolio/kabardinka","children":[["$","span",null,{"className":"section-label","children":"Следующий проект"}],["$","span",null,{"children":"Гостиница Кабардинка"}],["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/kabardinka/01.jpg","alt":"","loading":"lazy"}]]}]]}]
