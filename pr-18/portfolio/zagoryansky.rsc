1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/zagoryansky/01.jpg","alt":"Дом в Загорянском"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Дом · Загорянский"}],["$","h1",null,{"children":"дом в п. Загорянский"}],["$","p",null,{"className":"pp-hero-quote","children":["— ","Низкий дом в соснах, сад важнее фасада."]}]]}]]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"Загорянский"}],["$","h2",null,{"children":"Сначала сосны. Потом крыша."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"Дом в Загорянском низкий, вытянут, стоит в соснах. Сад с камнями и дорожками сделан раньше, чем хочется говорить о фасаде."}],["$","p",null,{"children":"Внутри — длинные виды через стекло, стол, дерево. Дом не комната с окном. Он продолжение сада."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/zagoryansky/02.jpg","alt":"Вечерний сад"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"На лесном участке фасад-витрина всегда проигрывает соснам. Я опускаю дом и отдаю первый план саду. Стекло нужно, чтобы сад вошёл внутрь, а не чтобы дом смотрелся с дороги."}]]}]]}],null,["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/zagoryansky/04.jpg","alt":"Вид через стекло"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Сад"}],["$","h2",null,{"children":"Вечер включает дорожки, не прожектор на стену."}],["$","p",null,{"children":"Вечерний кадр показывает сад: камни, свет у земли, дом сбоку. План подтверждает, что объём длинный и лежит между деревьями, а не посреди поляны."}]]}]]}],["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Дом в Загорянском."}],["$","p",null,{"className":"pp-facts","children":"Загорянский · сосны · проект"}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/zagoryansky/03.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"children":"Посадить низкий дом в существующий лес. Сделать сад частью плана, не озеленением после фасада."}],["$","p",null,{"className":"pp-line","children":["— ","Если сад сильнее фасада, фасад сделан правильно."]}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article","Высота",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Высота"}],["$","p",null,{"children":"Дом ниже сосен и не спорит с ними."}]]}],["$","article","Сад",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Сад"}],["$","p",null,{"children":"Дорожки и камни — первый план."}]]}],["$","article","Стекло",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Стекло"}],["$","p",null,{"children":"Вид изнутри длинный, стол стоит в этом виде."}]]}]]}],["$","a",null,{"className":"next-project","href":"/site-AB-IM/pr-18/portfolio/novoe","children":[["$","span",null,{"className":"section-label","children":"Следующий проект"}],["$","span",null,{"children":"дом Новое"}],["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/novoe/01.jpg","alt":"","loading":"lazy"}]]}]]}]
