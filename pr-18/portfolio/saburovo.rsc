1:["$","main",null,{"id":"content","className":"inner-page pp pp-saburovo","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/saburovo/01.jpg","alt":"Сабурово Клаб сверху: дома среди сосен"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Заказчик · Красногорск"}],["$","h1",null,{"children":"Сабурово Клаб"}],["$","p",null,{"className":"pp-hero-quote","children":"— Лес остаётся. Дома встают в него."}]]}]]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"14 га · 134 дома · 10 км от Москвы"}],["$","h2",null,{"children":"Клубный посёлок в сосновом лесу."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"Сабурово Клаб стоит у деревни Сабурово, между Волоколамским и Пятницким. ФСК собрала его как клуб: немного домов, один характер фасадов, клинкер и тёмная кровля. Треть земли отдана парку. Ландшафтную концепцию делала студия Verto. Жители пишут об одном и том же: тишина небольшого посёлка и то, что дома не рассыпаются в разные коттеджи."}],["$","p",null,{"children":"Дома и межевание пришли готовыми. Бюро взяло рабочую документацию генплана: посадить каждый дом на свой участок, поправить то, что не встаёт, и посчитать, как уходит вода с дорог и тротуаров. Посёлок построен."}]]}]]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/saburovo/02.jpg","alt":"План вертикальной планировки: посадка домов и въездная группа"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","h2",null,{"children":"Не рисовать посёлок заново."}],["$","p",null,{"children":"Мне принесли готовые дома и уже нарезанные участки. Задача была поставить каждый дом так, чтобы он встал, и чтобы улица не оставляла воду у порога. Где типовой проект не помещался, убирали навес, а не ломали участок."}]]}]]}],["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Генплан, на котором дом уже стоит на своём месте."}],["$","p",null,{"className":"pp-facts","children":"Красногорск · 14 га · 134 участка · 2024 · построено"}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/pr-18/assets/portfolio/saburovo/01.jpg","alt":"Въезд и петля дороги среди леса"}],["$","div",null,{"children":[["$","p",null,{"children":"Чертёж называется просто: корректировка схемы планировки с привязкой жилых домов и въездной группы. На нём отметки земли, дождевые решётки, граница очереди. Рядом — гидравлический расчёт дождевых стоков. Это не концепция «жизни в лесу». Это земля, на которой эта жизнь должна стоять."}],["$","p",null,{"className":"pp-line","children":"— Сначала участок. Потом дом."}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Посадка"}],["$","p",null,{"children":"Каждый дом привязан к своему участку. Тип, который не встаёт, правят. Землю под него не растягивают."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Вода"}],["$","p",null,{"children":"Вертикальная планировка улиц и гидравлика дождя — часть генплана, не приложение после факта."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Въезд"}],["$","p",null,{"children":"Въездная группа и дома одной очереди сидят на одном листе. Лес и парк остаются за кадром забора."}]]}]]}],["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Заказчик"}],["$","p",null,{"children":"ФСК. Дома и межевание были до нас. Парк — ландшафтная студия Verto."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Бюро"}],["$","p",null,{"children":"Стадия Р. Посадка домов, вертикальная планировка, расчёт дождевых стоков."}]]}]]}],"$L10","$L11"]}]
