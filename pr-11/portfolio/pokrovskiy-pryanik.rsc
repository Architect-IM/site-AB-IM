1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0387.jpg","alt":"Фабрика «Покровский пряник» в Нагорном"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Заказчик · Нагорный"}],["$","h1",null,{"children":"Покровский пряник"}],["$","p",null,{"className":"pp-hero-quote","children":"— Печатный пряник, который стал местом."}]]}]]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"1998 — сегодня"}],["$","h2",null,{"children":"С двух деревянных форм."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"Виктор Геннадьевич Вахлин в 1998 году вырезал из дерева две формы — петушка и самовара — и собрал пряник, которого здесь не пекли: варёная сгущёнка и грецкий орех. В 2000 году это имя стало брендом и патентом."}],["$","p",null,{"children":"Сначала было пятнадцать человек, ручной замес и бытовые печи. Сегодня пряник печатают, расписывают и глазируют люди. Гость смотрит на цех сверху и не останавливает работу. «Пряничная сказка» с 2016 года приняла больше ста тысяч человек."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0313.jpg","alt":"Ирина Михейкина с пряником в фирменном магазине"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"На выставке «Россия» здесь испекли пряник два на три метра. Алексей Леонов приезжал на производство — портрет остался в музее фабрики. Это не полка у трассы между Москвой и Владимиром. Сюда едут специально."}]]}]]}],["$","$L10",null,{"photos":[{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0276.jpg","alt":"Зал фабрики: часы, лестница, витрина"},{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0288.jpg","alt":"Фирменный магазин, полки с пряником"},{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0317.jpg","alt":"Печатный пряник «Владимир» в руках"},{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0334.jpg","alt":"Шоколадные фонтаны"},{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0423.jpg","alt":"Вывеска «Покровский пряник»"}]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0372.jpg","alt":"Пешеходный настил между корпусами"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Маршрут уже есть"}],["$","h2",null,{"children":"От пряника к шоколаду — пешком."}],["$","p",null,{"children":"Группа выходит от пряничной фабрики и идёт к шоколадной по настилу, через берёзы. Автобус пока встаёт у пряника. Парк, площадка и сцена — впереди. Ёлку здесь уже наряжают к Новому году."}]]}]]}],["$","div",null,{"className":"pp-pair","children":[["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0361.jpg","alt":"Настил через берёзовый лес"}],["$","figcaption",null,{"children":"Настил через берёзы"}]]}],["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0415.jpg","alt":"Лесная тропа на территории"}],["$","figcaption",null,{"children":"Тропа, с которой начнётся парк"}]]}]]}],["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Бывшее овощехранилище. Теперь шоколадная фабрика."}],["$","p",null,{"className":"pp-facts","children":"Нагорный · 830 м² · 2023 · работает"}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0356.jpg","alt":"Кирпичный корпус шоколадной фабрики"}],"$L11"]}],"$L12","$L13","$L14","$L15","$L16"]}]
:HL["/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0339.jpg","image"]
11:["$","div",null,{"children":[["$","p",null,{"children":"Половина здания была закрыта: аварийные конструкции, снаружи вид катакомб. В другой половине уже варили конфеты. Нужно было быстро обследовать, починить и не трогать несущие. Вписать туристов в действующее производство. Добавить мастер-классы, магазин, кафе и санузлы. Развести путь гостя и путь персонала."}],["$","p",null,{"className":"pp-line","children":"— Увидели не руины, а возможности."}]]}]
12:["$","section",null,{"className":"pp-moves","children":[["$","article",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Не спрятали"}],["$","p",null,{"children":"Кирпич и металл остались. Дети могут понять, чем здание было. Окна — иллюминаторы в цех или витраж к производству. Лофт и расстекловка держат память места, а не рисуют новый фасад поверх."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Кольцо для гостя"}],["$","p",null,{"children":"В небольшом объёме маршрут проходит производство по шагам и не сталкивается с персоналом. Рядом — магазин и кафе. Насыпи вокруг старого корпуса становятся игровой геопластикой."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Территория дальше здания"}],["$","p",null,{"children":"Экотропа уже работает. Дальше — детская площадка и сцена с амфитеатром. Фабрика собирает центр детского творчества внутри развития Нагорного, в стороне от дороги."}]]}]]}]
13:["$","div",null,{"className":"pp-wide","children":["$","img",null,{"src":"/site-AB-IM/pr-11/assets/portfolio/pokrovskiy-pryanik/img_0339.jpg","alt":"Шоколадная витрина в обновлённом корпусе"}]}]
14:["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Архитектор"}],["$","p",null,{"children":"Мастер-план территории и мастер-план живого туристического объекта. Место, куда возвращаются, а не точка на чужом маршруте."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Бюро"}],["$","p",null,{"children":"Обследование, рабочая документация и функция технического заказчика. Технические решения при небольшом бюджете, без лишней перестройки."}]]}]]}]
