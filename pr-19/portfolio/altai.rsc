1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/pr-19/assets/portfolio/altai/01.jpg","alt":"Стеклянный объём над склоном"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Гостиница · Алтай"}],["$","h1",null,{"children":"Гостиница Алтай"}],["$","p",null,{"className":"pp-hero-quote","children":["— ","Стеклянный объём над склоном, а не вместо него."]}]]}]]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"Алтай"}],["$","h2",null,{"children":"Дом на сваях над цветами и водой."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"На Алтае гостиница не врезается в склон фундаментом на всю ширину. Стеклянный объём стоит на опорах, под ним остаётся земля, цветы, проход."}],["$","p",null,{"children":"Рядом вода и отдельный деревянный павильон у берега. Ночью тот же объём светится, но не становится рекламным щитом."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/pr-19/assets/portfolio/altai/02.jpg","alt":"Павильон у воды"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"Склон здесь сильнее здания. Если его залить подпорной стеной, гостиницы уже нет — есть площадка. Я оставляю землю под домом и ставлю стекло так, чтобы горы были в комнате, а не на открытке за окном."}]]}]]}],null,["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/pr-19/assets/portfolio/altai/04.jpg","alt":"Павильон на берегу"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Как это собрано"}],["$","h2",null,{"children":"План держит тот же жест."}],["$","p",null,{"children":"Аксонометрия и план показывают не «красивый фасад», а то, как объём садится на рельеф: опоры, террасы, отдельный павильон у воды. Картинка и чертёж про одно и то же."}]]}]]}],["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Гостиница на рельефе."}],["$","p",null,{"className":"pp-facts","children":"Алтай · склон · проект"}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/pr-19/assets/portfolio/altai/03.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"children":"Стекло, дерево, настил, вода. Главный ход — не закрыть склон. Гость идёт по мосткам, дом пропускает землю под собой."}],["$","p",null,{"className":"pp-line","children":["— ","Здание стоит на месте. Место под ним остаётся."]}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article","Опоры",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Опоры"}],["$","p",null,{"children":"Дом не запечатывает землю. Под ним можно пройти."}]]}],["$","article","Стекло",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Стекло"}],["$","p",null,{"children":"Горы попадают в интерьер без лишней рамы."}]]}],["$","article","Берег",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Берег"}],["$","p",null,{"children":"Отдельный павильон у воды, не пристройка к номеру."}]]}]]}],["$","a",null,{"className":"next-project","href":"/site-AB-IM/pr-19/portfolio/gostec","children":[["$","span",null,{"className":"section-label","children":"Следующий проект"}],["$","span",null,{"children":"Гостиница Гостец"}],["$","img",null,{"src":"/site-AB-IM/pr-19/assets/portfolio/gostec/01.jpg","alt":"","loading":"lazy"}]]}]]}]
