1:["$","main",null,{"id":"content","className":"inner-page pp pp-zhar","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/pr-31/assets/portfolio/zhar-ptitsa/evening.jpg","alt":"Банный комплекс на Истре вечером: терраса и бассейн"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","img",null,{"className":"pp-client-logo","src":"/site-AB-IM/pr-31/assets/portfolio/zhar-ptitsa/logo.svg","width":111,"height":140,"alt":"","aria-hidden":"true"}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Истра · 2025"}],["$","h1",null,{"children":"Жар-Птица"}],["$","p",null,{"className":"pp-hero-quote","children":"— Сказка начинается здесь."}]]}]]}]]}],["$","section",null,{"className":"talk-band","children":["$","aside",null,{"className":"service-lead-aside service-lead-stack talk-slot","children":[["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/pr-31/assets/portfolio/zhar-ptitsa/evening.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","blockquote",null,{"children":[["$","p","На Новой Риге один модуль «Жар-Птицы» уже стоял и успешно сдавался гостям. Заказчик принял решение о возведении и запуске ещё одного банного комплекса — на Истре, на четыре блока. Мы с нуля сделали всю архитектуру, но это полдела: самой сложной оказалась инженерка — вода и тепло.",{"children":"На Новой Риге один модуль «Жар-Птицы» уже стоял и успешно сдавался гостям. Заказчик принял решение о возведении и запуске ещё одного банного комплекса — на Истре, на четыре блока. Мы с нуля сделали всю архитектуру, но это полдела: самой сложной оказалась инженерка — вода и тепло."}]]}]]}]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/pr-31/assets/portfolio/zhar-ptitsa/existing.jpg","alt":"Действующий корпус «Жар-Птицы»"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Бюро"}],["$","h2",null,{"children":"Четыре модуля за короткий срок."}],["$","p",null,{"children":"Сначала по проекту собрали ведомости объёмов работ. Это позволило провести тендер по проектной документации и выбрать подрядчиков-строителей по прозрачным ценам. Удалось привязать корпус на существующем участке, сохранив технические и пожарные разрывы от существующих зданий, а также обойдя существующие деревья."}]]}]]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/pr-31/assets/portfolio/zhar-ptitsa/garden.jpg","alt":"Террасы и посадки у банного комплекса"}],["$","div",null,{"children":["$","p",null,{"children":"В банях, особенно таких — современных, технологичных, красивых, — всегда хватает сложных вопросов при проектировании. Двойное утепление, паро- и гидроизоляция, и ещё больше — водоподготовка: высокие требования к качеству и количеству воды, помноженные на технико-экономическое обоснование. Словом, просто здесь не было. Но все вопросы были решены, объект находится на стадии строительства и, надеюсь, совсем скоро порадует лёгким паром своих гостей!"}]}]]}],["$","div",null,{"className":"pp-pair","children":[["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/pr-31/assets/portfolio/zhar-ptitsa/terrace.jpg","alt":"Бассейн на террасе"}],["$","figcaption",null,{"children":"Терраса с бассейном"}]]}],["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/pr-31/assets/portfolio/zhar-ptitsa/existing.jpg","alt":"Модуль, который уже работает"}],["$","figcaption",null,{"children":"Модуль, который уже работает"}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article",null,{"children":["$L10","$L11","$L12"]}],"$L13","$L14"]}],"$L15","$L16","$L17"]}]
10:["$","span",null,{"children":"01"}]
11:["$","h3",null,{"children":"Четыре модуля"}]
12:["$","p",null,{"children":"Четыре дома одного типа, каждый со своей террасой. Внутри парная, снаружи холодная купель и бассейн."}]
13:["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Час на купель"}],["$","p",null,{"children":"Три кубометра тёплой воды должны обновиться, пока убирают номер. Подобрали насосы, фильтры и котлы с учётом ТЭО."}]]}]
14:["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Одна котельная"}],["$","p",null,{"children":"Отопление, вентиляция, нагрев купели и очистка воды живут в одном помещении. Котельная спроектирована полностью, газовое оборудование работает от газгольдера."}]]}]
15:["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Бюро"}],["$","p",null,{"children":"Углубились в инженерные вопросы и привлекли подрядчиков-монтажников. Отопление и водоподготовка собраны не «по каталогу», а под режим аренды."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Сейчас"}],["$","p",null,{"children":"Объект строится. Четыре блока, 850 м², Истра, 2025."}]]}]]}]
