1:["$","main",null,{"id":"content","className":"inner-page client-page","children":[["$","section",null,{"className":"client-hero","children":[["$","img",null,{"src":"/site-AB-IM/irina/assets/portfolio/pokrovskiy-pryanik/img_0356.jpg","alt":"Вывеска «Покровский пряник» на кирпичном корпусе"}],["$","div",null,{"className":"client-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Заказчик"}],["$","h1",null,{"children":"Покровский пряник"}],["$","p",null,{"children":"Производство печатного пряника в Покрове. Кирпичные цеха, двор между корпусами и зал, где тесто становится изделием."}]]}]]}],["$","section",null,{"className":"client-place","children":[["$","img",null,{"src":"/site-AB-IM/irina/assets/portfolio/pokrovskiy-pryanik/img_0426.jpg","alt":"Территория завода с высоты"}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Покров · Владимирская область"}],["$","p",null,{"children":"Действующий завод, не павильон. Корпуса стоят вдоль дороги, между ними двор, дальше силосы и новые пролёты. Гость, если его пустить, должен понять место с порога и не попасть под работу цеха."}]]}]]}],["$","section",null,{"className":"client-work","children":[["$","p",null,{"className":"section-label","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Обследование, проект и то, как цех принимает человека."}]]}],["$","section",null,{"className":"client-block","children":["$","div",null,{"className":"client-split","children":[["$","img",null,{"src":"/site-AB-IM/irina/assets/portfolio/pokrovskiy-pryanik/img_0340.jpg","alt":"Светлый производственный зал"}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Живое гостеприимство"}],["$","h2",null,{"children":"Зал уже умеет быть светлым"}],["$","p",null,{"children":"Новый пролёт высокий и ровный. Здесь можно показать, как делается пряник, если путь гостя не пересекается с тележками и паром."}],["$","blockquote",null,{"children":"Не украшать производство. Сделать так, чтобы человек понимал, где он, и не мешал цеху."}],["$","p",null,{"className":"client-by","children":"Ирина Михейкина, архитектор"}]]}]]}]}],["$","section",null,{"className":"client-block client-wide","children":[["$","img",null,{"src":"/site-AB-IM/irina/assets/portfolio/pokrovskiy-pryanik/img_0324.jpg","alt":"Варочные котлы в цехе"}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Стадия П"}],["$","h2",null,{"children":"Котлы держат центр зала"}],["$","p",null,{"children":"Проектная документация собирает существующие корпуса и новый объём в одну систему: пролёты, кровля, инженерия. Не отдельный красивый зал рядом с заводом."}],["$","blockquote",null,{"children":"Сначала то, без чего цех не варит. Потом то, как это стоит в конструкциях."}],["$","p",null,{"className":"client-by","children":"Конструктор бюро"}]]}]]}],["$","section",null,{"className":"client-block","children":[["$","div",null,{"className":"client-pair","children":[["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/irina/assets/portfolio/pokrovskiy-pryanik/img_0284.jpg","alt":"Трубопроводы вдоль кирпичной стены"}],["$","figcaption",null,{"children":"Инженерия уже есть. Её нельзя нарисовать заново и забыть."}]]}],["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/irina/assets/portfolio/pokrovskiy-pryanik/img_0300.jpg","alt":"Переход между корпусами"}],["$","figcaption",null,{"children":"Переходы между корпусами — часть пути, не служебный остаток."}]]}]]}],["$","div",null,{"className":"client-note","children":[["$","p",null,{"className":"section-label","children":"Обследование"}],["$","h2",null,{"children":"Сначала то, что уже стоит"}],["$","p",null,{"children":"Выезд фиксирует корпуса, пристройки, трубы и где людям тесно. Без этого стадия П описывает желаемый завод, а не этот."}]]}]]}],["$","section",null,{"className":"client-scheme","children":[["$","svg",null,{"viewBox":"0 0 640 360","role":"img","aria-lab