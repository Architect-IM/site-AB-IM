1:[[["$","link","css:/site-AB-IM/pr-20/_next/static/css/links.BNNq5a68.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/site-AB-IM/pr-20/_next/static/css/links.BNNq5a68.css","data-rsc-css-href":"/site-AB-IM/pr-20/_next/static/css/links.BNNq5a68.css"}],"$undefined"],["$","main",null,{"id":"content","className":"inner-page _page_19p29_1","children":[["$","section",null,{"className":"_hero_19p29_15","aria-labelledby":"houses-title","children":[["$","nav",null,{"className":"_breadcrumbs_19p29_2 _heroBreadcrumbs_19p29_24","aria-label":"Навигация по разделу","children":[["$","a",null,{"href":"/site-AB-IM/pr-20/#directions","children":"← На главную"}],["$","span",null,{"aria-current":"page","children":"Частные владения"}]]}],["$","div",null,{"className":"_heroImage_19p29_22","children":["$","img",null,{"src":"/site-AB-IM/pr-20/assets/home-private-meadow-life.jpg","alt":"Деревянный дом с резными фронтонами, девушка на крыльце и козы на лугу","fetchPriority":"high"}]}],["$","div",null,{"className":"_heroCopy_19p29_26","children":[["$","p",null,{"className":"_eyebrow_19p29_10","children":"04"}],["$","h1",null,{"id":"houses-title","children":"Частные владения"}],["$","p",null,{"className":"_subtitle_19p29_29","children":"Дома и территории"}]]}]]}],["$","section",null,{"className":"product-talk","aria-labelledby":"$undefined","children":[["$","div",null,{"className":"product-talk-copy","children":[null,null,["$","p",null,{"children":"Частный дом для меня — не метраж, а способ жить на своей земле. Собираю его так, чтобы не было лишнего: характер растёт из вашей жизни и запроса; традиции места и природа включаются в ансамбль, а быт — семья, гости, хозяйство — встаёт на свои места. Любые материалы, техники и приёмы доступны — берём то, что лучше всего подойдёт к вашему случаю. На площадке строю прямой разговор между вами, проектом и теми, кто строит: комфорт сегодня и запас на завтра, чтобы жить здесь было хорошо много-много лет."}]]}],["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/pr-20/assets/portrait.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}]]}],["$","section",null,{"id":"estate-analysis","className":"_analysis_19p29_37","aria-labelledby":"analysis-title","children":["$","div",null,{"className":"_analysisGrid_19p29_38","children":[["$","div",null,{"className":"_analysisImage_19p29_39","children":["$","img",null,{"src":"/site-AB-IM/pr-20/assets/territory.jpg","alt":"Ландшафт, река и застройка на высоком берегу","loading":"lazy"}]}],["$","div",null,{"className":"_analysisCopy_19p29_41","children":[["$","p",null,{"className":"_eyebrow_19p29_10","children":"01"}],["$","h2",null,{"id":"analysis-title","children":"Предпроектный анализ частных владений"}],["$","p",null,{"children":"Знакомство с будущим проектом, аудит ситуации и первичный синтез решения. Ищу предпосылки и барьеры, вижу возможности и риски. Смотрю широко и ухожу вглубь ровно настолько, чтобы не проектировать вслепую."}],[[["$","link","css:/site-AB-IM/pr-20/_next/static/css/links.BNNq5a68.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/site-AB-IM/pr-20/_next/static/css/links.BNNq5a68.css","data-rsc-css-href":"/site-AB-IM/pr-20/_next/static/css/links.BNNq5a68.css"}],"$undefined"],["$","a",null,{"className":"_action_19p29_9","href":"/site-AB-IM/pr-20/napravleniya/houses/estate-analysis","children":[[["$","link","css:/site-AB-IM/pr-20/_next/static/css/links.BNNq5a68.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/site-AB-IM/pr-20/_next/static/css/links.BNNq5a68.css","dat