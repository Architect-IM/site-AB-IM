14:["$","div",null,{"className":"brand-path","children":[["$","p",null,{"className":"brand-creed","children":[["$","span",null,{"children":"Вы творите."}],["$","span",null,{"children":"Мы изучаем, ограняем, укрепляем, воспеваем и продвигаем."}]]}],["$","ol",null,{"className":"brand-steps","children":[["$","li","01",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Аудит"}],["$","p",null,{"children":"Изучаем ценностное предложение, смотрим, насколько далеко ваше обещание можно развернуть, не выдумав того, чего нет. Ищем на рынке целевой сегмент, смотрим окружение, считаем, какая цена делает дело интересным для всех. Мы не пытаемся обойти всех, скорее мы стараемся не заговорить чужим голосом."}]]}]]}],["$","li","02",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Портфель"}],["$","p",null,{"children":"Продукт — рыночное оружие. Так у любого дела. Из потенциала, который есть на самом деле, собираем, что можно выставить. И сразу намечаем, как этот потенциал растить, чтобы он дотягивал до целей. На любом горизонте."}]]}]]}],["$","li","03",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Цели"}],["$","p",null,{"children":"Иногда цель уже названа, и мы проверяем, хватает ли на неё потенциала. Иногда ставим её вместе. Цели женим с продуктами и с ресурсами, в том числе с тем, как здесь вообще считаются деньги. Все должны одинаково понимать, куда идут, зачем, и трезво оценивать возможности и угрозы."}]]}]]}],["$","li","04",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Стратегия"}],["$","p",null,{"children":"Коктейль из метода, способа и плана. Такой, который все стороны без оговорок принимают за эталон вкуса и гармонии. Задача непростая. Когда берёмся — решаем."}]]}]]}],["$","li","05",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"05"}],["$","div",null,{"children":[["$","h3",null,{"children":"До результата"}],["$","p",null,{"children":"Если стратегия принята и в ней нужна наша помощь, мы будем работать. Коммуникации, сайт, СМИ, дизайн — любые маркетинговые задачи. Поможем пройти весь путь. Вы творите замысел. Мы его держим."}]]}]]}]]}],["$","section",null,{"className":"brand-close","children":[["$","h2",null,{"children":"Сначала место."}],["$","p",null,{"children":["Прежде всего — мы архитектурное бюро. Обычно мы берёмся за маркетинг тогда, когда проектируем или ведём какую-то стройку: опыт начинается с места, а не с объявления. Чаще всего это ",["$","a",null,{"href":"/site-AB-IM/pr-20/#directions","children":"живое гостеприимство"}],", хотя бывает и другое. Если вам нужна помощь — приходите, договоримся."]}],["$","p",null,{"className":"brand-close-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","section",null,{"className":"brand-been","aria-label":"Примеры","children":[["$","h2",null,{"children":"Наши клиенты"}],["$","div",null,{"className":"brand-been-grid","children":[["$","a","pokrovskiy-pryanik",{"href":"/site-AB-IM/pr-20/portfolio/pokrovskiy-pryanik","children":[["$","img",null,{"src":"/site-AB-IM/pr-20/assets/portfolio/pokrovskiy-pryanik/img_0356.jpg","alt":"","style":{"objectPosition":"center 22%"}}],["$","h3",null,{"children":"Покровский пряник"}]]}],["$","a","dobrograd",{"href":"/site-AB-IM/pr-20/portfolio/dobrograd","children":[["$","img",null,{"src":"/site-AB-IM/pr-20/assets/portfolio/dobrograd/01.jpg","alt":"","style":"$undefined"}],["$","h3",null,{"children":"Доброград"}]]}],["$","a","ivan-zaitsev",{"href":"/site-AB-IM/pr-20/portfolio/ivan-zaitsev","children":[["$","img",null,{"src":"/site-AB-IM/pr-20/assets/portfolio/ivan-zaitsev/01.jpg","alt":"","style":"$undefined"}],["$","h3",null,{"children":"Иван Зайцев"}]]}]]}]]}]]}]
15:["$","article",null,{"className":"marketing-chapter","id":"comms","children":[["$","section",null,{"className":"page-intro","children":[["$","p",null,{"className":"section-label","children":"03"}],["$","h2",null,{"children":"Коммуникационная стратегия"}],["$","p",null,{"className":"service-essence","children":"Система целей, сообщений, каналов и способов измерения. Коммуникации растут из сути проекта и бренда, а не живут отдельно."}]]}],["$","section",null,{"className":"section service-sections","children":[["$","div","who",{"children":[["$","p",null,{"className":"section-label","children":"Для кого и когда"}],["$","p",null,{"children":"Предприниматели, которым нужна управляемость интереса к проекту — на старте или когда активности уже есть, но нет общей логики."}]]}],["$","div","gets",{"children":[["$","p",null,{"className":"section-label","children":"Что в результате?"}],["$","p",null,{"children":"Рамку: что говорить, кому, через какие каналы и как понимать, что это работает."}]]}],["$","div","how",{"children":[["$","p",null,{"className":"section-label","children":"Как работаем"}],["$","p",null,{"children":"Аудит коммуникаций, если они есть. Собираем цели, сообщения и логику каналов. При необходимости сопровождаем исполнение."}]]}],["$","div","why",{"children":[["$","p",null,{"className":"section-label","children":"Почему это важно"}],["$","p",null,{"children":"Разрозненные коммуникации быстро теряют силу и бюджет."}]]}],["$","div","next",{"children":[["$","p",null,{"className":"section-label","children":"Формат и следующий шаг"}],["$","p",null,{"children":"Стратегия с планом действий. Затем последовательное исполнение, а не разовые акции."}]]}]]}]]}]
