1:[[["$","link","css:/site-AB-IM/mihail/_next/static/css/links.CzMxZWBp.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/site-AB-IM/mihail/_next/static/css/links.CzMxZWBp.css","data-rsc-css-href":"/site-AB-IM/mihail/_next/static/css/links.CzMxZWBp.css"}],"$undefined"],["$","main",null,{"id":"content","className":"inner-page _page_r1xh0_1","children":[["$","section",null,{"className":"_hero_r1xh0_16","aria-label":"Частные владения","children":[["$","nav",null,{"className":"_breadcrumbs_r1xh0_2 _heroBreadcrumbs_r1xh0_26","aria-label":"Навигация по разделу","children":[["$","a",null,{"href":"/site-AB-IM/mihail/#directions","children":"← На главную"}],["$","span",null,{"aria-current":"page","children":"Частные владения"}]]}],["$","div",null,{"className":"_heroImage_r1xh0_23","children":["$","img",null,{"src":"/site-AB-IM/mihail/assets/home-private-meadow-life.jpg","alt":"Деревянный дом с резными фронтонами, девушка на крыльце и козы на лугу","fetchPriority":"high"}]}]]}],["$","section",null,{"className":"product-talk product-talk-film","aria-labelledby":"product-lead-title","children":[["$","div",null,{"className":"product-talk-copy","children":[["$","p",null,{"className":"product-talk-kicker","children":"04"}],["$","h1",null,{"id":"product-lead-title","children":"Частные владения"}],["$","p",null,{"children":"Частный дом для меня — не метраж, а способ жить на своей земле. Собираю его так, чтобы не было лишнего: характер растёт из вашей жизни и запроса; традиции места и природа включаются в ансамбль, а быт — семья, гости, хозяйство — встаёт на свои места. Любые материалы, техники и приёмы доступны — берём то, что лучше всего подойдёт к вашему случаю. На площадке строю прямой разговор между вами, проектом и теми, кто строит: комфорт сегодня и запас на завтра, чтобы жить здесь было хорошо много-много лет."}]]}],["$","figure",null,{"children":[["$","$L10",null,{"src":"/site-AB-IM/mihail/assets/houses-talk.mp4","poster":"/site-AB-IM/mihail/assets