ины"}],["$","blockquote",null,{"children":["«","Горизонталь важнее фасада. Камень и стекло — чтобы бор читался сквозь дом, а не вокруг него.","»"]}],["$","span",null,{"children":"Ирина Михейкина · Архитектор"}]]}],["$","section",null,{"className":"section story-grid","children":[["$","p",null,{"className":"section-label","children":"03 — Результат"}],["$","h2",null,{"children":"Тихий объём. Дом работает как рама для света, а не как объект напоказ."}]]}],["$","a",null,{"className":"next-project","href":"/site-AB-IM/mihail/bureau/portfolio/complex","children":[["$","span",null,{"className":"section-label","children":"Следующий проект"}],["$","span",null,{"children":"Двор на склоне"}],["$","img",null,{"src":"/site-AB-IM/mihail/assets/resort.jpg","alt":"","loading":"lazy"}]]}]]}]
