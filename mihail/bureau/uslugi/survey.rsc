1:["$","main",null,{"id":"content","className":"inner-page bureau-page service-page stage-page","children":[["$","section",null,{"className":"page-intro","children":["$","p",null,{"className":"section-label crumb-levels","children":[["$","a",null,{"href":"/site-AB-IM/mihail/bureau","children":"← Бюро"}],["$","a",null,{"href":"/site-AB-IM/mihail/bureau#engineering","children":["← ","Конструкции и инженерия"]}]]}]}],["$","section",null,{"className":"product-talk product-talk-key","aria-labelledby":"product-lead-title","children":[["$","div",null,{"className":"product-talk-copy","children":[null,["$","h1",null,{"id":"product-lead-title","children":"Обследование зданий и технический аудит"}],["$","p",null,{"children":"Проверка фактического состояния конструкций и систем с расчётным обоснованием по ГОСТ и СП, с современным оборудованием."}]]}],["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portrait.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"руководитель бюро"}]]}]]}]]}],["$","$L10",null,{"title":"Обследование зданий и технический аудит"}],[[["$","section","take-0",{"className":"p-take","children":[["$","div",null,{"children":[["$","h2",null,{"children":"Обосновано расчётами."}],["$","p",null,{"children":"Обследование по ГОСТ 31937 и СП 13-102 начинается со сплошного осмотра и им не кончается: дальше вскрытия, фактические сечения, прочность и армирование. Архивный чертёж — гипотеза, пока его не подтвердили на месте. Все дефекты попадают в ведомость не только с указанием размеров и привязок, но и чётким выводом и рекомендацией. Категорию общего технического состояния даёт поверочный расчёт по фактической схеме и нагрузкам, а не ширина трещины на глаз. Из заключения видно, что оставить, что ограничить и что усиливать."}]]}],["$","img",null,{"src":"/site-AB-IM/mihail/assets/house.jpg","alt":""}]]}],["$","section","quiet-0",{"className":"p-quiet","children":[["$","h2",null,{"children":"Для кого и когда"}],["$","p",null,{"children":"Собственники и инвесторы перед реконструкцией, капремонтом, сменой функционала или просто для понимания реального состояния."}]]}],["$","section","take-1",{"className":"p-take p-take-wide","children":[["$","video",null,{"src":"/site-AB-IM/mihail/assets/survey-orbit.mp4","autoPlay":true,"muted":true,"loop":true,"playsInline":true}],["$","div",null,{"children":[["$","h2",null,{"children":"Техническая вооружённость."}],["$","p",null,{"children":"Используем широкий парк современного диагностического оборудования и технологий — под любую задачу. Если результаты разнятся, удобную цифру не выбираем: измеряем ещё раз, другим способом, результаты фиксируем в заключении. Особо сложные или узкие вопросы с удовольствием отдаём проверенным экспертам на субподряд. Тогда в дело ложится его протокол, а не наш пересказ."}]]}]]}],["$","section","quiet-1",{"className":"p-quiet","children":[["$","h2",null,{"children":"Что в результате?"}],["$","p",null,{"children":"Полноценный отчёт, достаточный для стратегических решений без риска ошибок."}]]}],["$","section","take-2",{"className":"p-review","aria-label":"Отзыв","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/saburovo/voice.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"className":"p-review-kicker","children":"Ценность, сказанная заказчиком"}],["$","h2",null,{"children":"Основа для решений."}],["$","blockquote",null,{"children":"Полноценный отчёт, достаточный для принятия стратегических решений без риска ошибок."}],["$","p",null,{"className":"p-review-sign","children":["Главный инженер",["$","span",null,{"children":"Доброград"}]]}]]}]]}],["$","section","quiet-why",{"className":"p-quiet","children":[["$","h2",null,{"children":"Почему это важно"}],["$","p",null,{"children":"Без точной картины состояния дальше проектируют вслепую."}]]}],"$L11","$L12"],"$L13"]]}]
