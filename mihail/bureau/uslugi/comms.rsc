1:["$","main",null,{"id":"content","className":"inner-page bureau-page service-page","children":[["$","section",null,{"className":"page-intro marketing-intro","children":["$","p",null,{"className":"section-label crumb-levels","children":[["$","a",null,{"href":"/site-AB-IM/mihail/","children":"← На главную"}],["$","a",null,{"href":"/site-AB-IM/mihail/bureau#marketing","children":"← Бюро"}]]}]}],["$","section",null,{"className":"product-talk","aria-labelledby":"product-lead-title","children":[["$","div",null,{"className":"product-talk-copy","children":[null,["$","h1",null,{"id":"product-lead-title","children":"Маркетинг"}],["$","p",null,{"children":"Если вы находитесь на этапе формирования, уточнения или даже пересмотра маркетинговой стратегии - мы можем помочь её собрать и увязать с проектными решениями будущего строительства. Только для клиентов бюро."}]]}],["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/finance-voice.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Михаил Лункин",["$","span",null,{"children":"маркетолог бюро"}]]}]]}]]}],["$","nav",null,{"className":"marketing-nav","aria-label":"Разделы","children":[["$","$L10",null,{}],["$","p",null,{"className":"marketing-rank marketing-rank-main","children":"Главное"}],["$","p",null,{"className":"marketing-rank marketing-rank-extra","children":"Дополнительно"}],["$","a",null,{"href":"#brand","children":[["$","span",null,{"children":"01"}],"Бренд-стратегия: аудит и разработка"]}],["$","a",null,{"href":"#finance","children":[["$","span",null,{"children":"02"}],"Финансово-экономическое моделирование"]}],["$","a",null,{"href":"#comms","children":[["$","span",null,{"children":"03"}],"Коммуникационная стратегия"]}]]}],["$","article",null,{"className":"marketing-chapter","id":"brand","children":[["$","section",null,{"className":"page-intro","children":[["$","p",null,{"className":"section-label","children":"01"}],["$","h2",null,{"children":"Бренд-стратегия: аудит и разработка"}],["$","p",null,{"className":"service-essence","children":"Поможем выстроить смысловую платформу вашего проекта и стратегию его представления на рынке."}]]}],["$","section",null,{"className":"finance-method brand-method","children":["$","h2",null,{"children":"Как это делаем мы"}]}],["$","div",null,{"className":"brand-path","children":[["$","p",null,{"className":"brand-creed","children":[["$","span",null,{"children":"Вы творите."}],["$","span",null,{"children":"Мы изучаем, ограняем, укрепляем, воспеваем и продвигаем."}]]}],["$","ol",null,{"className":"brand-steps","children":[["$","li","01",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Аудит"}],["$","p",null,{"children":"Изучаем ценностное предложение, смотрим, насколько далеко ваше обещание можно развернуть, не выдумав того, чего нет. Ищем на рынке целевой сегмент, смотрим окружение, считаем, какая цена делает дело интересным для всех. Мы не пытаемся обойти всех, скорее мы стараемся не заговорить чужим голосом."}]]}]]}],["$","li","02",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Портфель"}],["$","p",null,{"children":"Продукт — рыночное оружие. Так у любого дела. Из потенциала, который есть на самом деле, собираем, что можно выставить. И сразу намечаем, как этот потенциал растить, чтобы он дотягивал до целей. На любом горизонте."}]]}]]}],["$","li","03",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Цели"}],["$","p",null,{"children":"Иногда цель уже названа, и мы проверяем, хватает ли на неё потенциала. Иногда ставим её вместе. Цели женим с продуктами и с ресурсами, в том числе с тем, как здесь вообще считаются деньги. Все должны одинаково понимать, куда идут, зачем, и трезво оценивать возможности и угрозы."}]]}]]}],"$L11","$L12"]}],"$L13"]}],"$L14"]}],"$L15","$L16"]}]
