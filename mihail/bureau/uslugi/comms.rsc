11:["$","li","04",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Стратегия"}],["$","p",null,{"children":"Коктейль из метода, способа и плана. Такой, который все стороны без оговорок принимают за эталон вкуса и гармонии. Задача непростая. Когда берёмся — решаем."}]]}]]}]
12:["$","li","05",{"className":"brand-step","children":[["$","span",null,{"className":"brand-num","children":"05"}],["$","div",null,{"children":[["$","h3",null,{"children":"До результата"}],["$","p",null,{"children":"Если стратегия принята и в ней нужна наша помощь, мы будем работать. Коммуникации, сайт, СМИ, дизайн — любые маркетинговые задачи. Поможем пройти весь путь. Вы творите замысел. Мы его держим."}]]}]]}]
13:["$","section",null,{"className":"brand-close","children":[["$","h2",null,{"children":"Сначала место."}],["$","p",null,{"children":["Прежде всего — мы архитектурное бюро. Обычно мы берёмся за маркетинг тогда, когда проектируем или ведём какую-то стройку: опыт начинается с места, а не с объявления. Чаще всего это ",["$","a",null,{"href":"/site-AB-IM/mihail/napravleniya/hospitality","children":"живое гостеприимство"}],", хотя бывает и другое. Если вам нужна помощь — приходите, договоримся."]}],["$","p",null,{"className":"brand-close-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}]
