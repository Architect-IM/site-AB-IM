1:["$","main",null,{"id":"content","className":"inner-page bureau-page service-page","children":[["$","section",null,{"className":"page-intro service-lead","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":["$","a",null,{"href":"/site-AB-IM/mihail/bureau#economics","children":["← ","Экономика объекта"]}]}],["$","h1",null,{"children":"Финансово-экономическое моделирование"}],["$","p",null,{"className":"service-essence","children":"Расчёт проекта в деньгах с разными сценариями."}]]}],["$","aside",null,{"className":"service-lead-aside","children":[["$","figure",null,{"children":[["$","img",null,{"className":"service-lead-photo","src":"/site-AB-IM/mihail/assets/finance-voice.jpg","alt":""}],["$","figcaption",null,{"className":"service-lead-sign","children":["Михаил Лункин",["$","span",null,{"children":"маркетолог бюро"}]]}]]}],["$","blockquote",null,{"children":"Мы не собираем максимально полную модель и без нужды не подгоняем её под МСФО и другие стандарты, а скорее помогаем сделать первый шаг к будущему подробному учёту. Вместе ответим на вопросы — как здесь вообще считаются деньги, как создаётся добавленная стоимость и как на это влияют проектные решения. Разбираем разные сценарии, чтобы было видно, что живёт, а где деньги не возвращаются."}]]}]]}],["$","section",null,{"className":"finance-method","children":[["$","h2",null,{"children":"Как это делается"}],["$","p",null,{"children":"Мы проводим все необходимые интервью и расчёты: что за объект, какие решения уже есть, откуда берутся деньги и доход. Потом собираем все цифры в таблицы, перепроверяем их на достоверность и полноту. После этого показываем результат инфографикой на закрытом сайте проекта, который мы делаем для каждого заказчика и храним там этот архив всех данных по его проекту."}],["$","p",null,{"className":"finance-method-next","children":"Ниже — пример."}]]}],["$","$L10",null,{}],["$","div",null,{"className":"finance-record","children":[["$","section",null,{"className":"finance-block finance-split","children":[["$","div",null,{"className":"finance-video","children":[["$","video",null,{"src":"/site-AB-IM/mihail/assets/finance-session.mp4","poster":"/site-AB-IM/mihail/assets/resort.jpg","muted":true,"loop":true,"autoPlay":true,"playsInline":true}],["$","span",null,{"children":"0:30 · запись рабочей сессии бюро"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Разбор"}],["$","h2",null,{"children":"Три сценария, не один прогноз"}],["$","p",null,{"children":"Как читаем допущения, где ломается «красивый» год и что из этого следует для объёма."}]]}]]}],["$","section",null,{"className":"finance-block finance-split","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/mansion.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Один ход"}],["$","h2",null,{"children":"Не строили второй объём"}],["$","p",null,{"children":"Заказчик держал береговой комплекс как «якорь территории»: два корпуса, ресторан, баня. Базовый сценарий ещё дышал. Осторожный — нет: заполняемость в межсезонье не несла второй объём, инженерия и берегоукрепление съедали запас. Сняли второй корпус на модели, до того как он появился на площадке. Первый объём пересобрали: меньше номеров, выше счёт с гостя, общий двор вместо второго дома."}],["$","p",null,{"className":"finance-fact","children":"Срок возврата 7,5 → 6,2. Второй объём остался в резерве земли, не в бетоне."}]]}]]}],["$","section",null,{"className":"finance-block finance-who","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Кому это нужно"}],["$","p",null,{"children":"Собственник или инвестор до серьёзных вложений. Когда уже есть идея или эскиз и хочется увидеть, живёт ли объект как дело — не как картинка."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"Кому нет"}],["$","p",null,{"children":"Кто ищет обоснование уже принятого решения. Кто просит «сделать красивую доходность для банка» без права менять программу. Это не наша работа."}]]}]]}],"$L11","$L12","$L13"]}],null]}]
11:["$","section",null,{"className":"finance-quote","children":[["$","blockquote",null,{"children":"Нам было неприятно увидеть осторожный сценарий. И правильно: мы не вывели на берег второй корпус, который кормили бы из кармана."}],["$","p",null,{"children":"Управляющий партнёр, туристический комплекс, Владимирская область"}]]}]
12:["$","section",null,{"className":"finance-block","children":[["$","p",null,{"className":"section-label","children":"Паспорт услуги"}],["$","dl",null,{"className":"finance-passport","children":[["$","div","Как работаем",{"children":[["$","dt",null,{"children":"Как работаем"}],["$","dd",null,{"children":"Собираем допущения. Считаем несколько сценариев. Не сглаживаем цифры ради комфорта."}]]}],["$","div","Почему это важно",{"children":[["$","dt",null,{"children":"Почему это важно"}],["$","dd",null,{"children":"Красивая архитектура без рабочей экономики быстро перестаёт радовать."}]]}],["$","div","Формат и следующий шаг",{"children":[["$","dt",null,{"children":"Формат и следующий шаг"}],["$","dd",null,{"children":"Модель с пояснениями. Затем уточнение концепции, параметров объекта или решение об инвестировании."}]]}]]}]]}]
