1:["$","main",null,{"id":"content","className":"inner-page bureau-page service-page","children":[["$","section",null,{"className":"page-intro service-lead","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":["$","a",null,{"href":"/site-AB-IM/mihail/bureau#economics","children":["← ","Экономика объекта"]}]}],["$","h1",null,{"children":"Финансово-экономическое моделирование"}],["$","p",null,{"className":"service-essence","children":"Расчёт проекта в деньгах с разными сценариями. Реальная доходность, а не один «красивый» прогноз."}]]}],["$","aside",null,{"className":"service-lead-aside","children":[["$","figure",null,{"children":[["$","img",null,{"className":"service-lead-photo","src":"/site-AB-IM/mihail/assets/finance-voice.jpg","alt":""}],["$","figcaption",null,{"className":"service-lead-sign","children":["Михаил Лункин",["$","span",null,{"children":"маркетолог бюро"}]]}]]}],["$","blockquote",null,{"children":"Мы не собираем максимально полную модель и без нужды не подгоняем её под МСФО и другие стандарты, а скорее помогаем сделать первый шаг к будущему подробному учёту. Вместе ответим на вопросы — как здесь вообще считаются деньги, как создаётся добавленная стоимость и как на это влияют проектные решения. Разбираем разные сценарии, чтобы было видно, что живёт, а где деньги не возвращаются."}]]}]]}],["$","section",null,{"className":"section service-sections","children":[["$","div","who",{"children":[["$","p",null,{"className":"section-label","children":"Для кого и когда"}],["$","p",null,{"children":"Инвесторы и собственники, которым важно увидеть экономику до серьёзных вложений."}]]}],["$","div","gets",{"children":[["$","p",null,{"className":"section-label","children":"Что в результате?"}],["$","p",null,{"children":"Прозрачную модель с вариантами развития, точками риска и условиями жизнеспособности."}]]}],["$","div","how",{"children":[["$","p",null,{"className":"section-label","children":"Как работаем"}],["$","p",null,{"children":"Собираем допущения. Считаем несколько сценариев. Не сглаживаем цифры ради комфорта."}]]}],["$","div","why",{"children":[["$","p",null,{"className":"section-label","children":"Почему это важно"}],["$","p",null,{"children":"Красивая архитектура без рабочей экономики быстро перестаёт радовать."}]]}],["$","div","next",{"children":[["$","p",null,{"className":"section-label","children":"Формат и следующий шаг"}],["$","p",null,{"children":"Модель с пояснениями. Затем уточнение концепции, параметров объекта или решение об инвестировании."}]]}]]}]]}]
