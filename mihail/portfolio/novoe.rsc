1:["$","main",null,{"id":"content","className":"inner-page pp pp-novoe","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/novoe/03.jpg","alt":"Усадьба «Нерль» со стороны поймы: терраса с камином и панорамный фасад"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Новое · 2024"}],["$","h1",null,{"children":"«Нерль»"}],["$","p",null,{"className":"pp-hero-quote","children":"— Русская усадьба с видом на Боголюбово."}]]}]]}],["$","section",null,{"className":"talk-band","children":["$","aside",null,{"className":"service-lead-aside service-lead-stack talk-slot","children":[["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/novoe/03.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","blockquote",null,{"children":[["$","p","К нам обратился заказчик с видовым участком в селе Новое, в районе Боголюбова. С него видно пойму и все окрестные красоты: храм Покрова на Нерли, Боголюбский монастырь, сёла по горизонту. К участку вела только грунтовая дорога, у дороги стояли старые большие дубы. Нужно было спроектировать и построить вместительный дом, чтобы там могла собираться большая семья — и чтобы всем было удобно, и чтобы было красиво. Согласовать представления о красоте оказалось совсем несложно. Мы договорились и отправились вперёд.",{"children":"К нам обратился заказчик с видовым участком в селе Новое, в районе Боголюбова. С него видно пойму и все окрестные красоты: храм Покрова на Нерли, Боголюбский монастырь, сёла по горизонту. К участку вела только грунтовая дорога, у дороги стояли старые большие дубы. Нужно было спроектировать и построить вместительный дом, чтобы там могла собираться большая семья — и чтобы всем было удобно, и чтобы было красиво. Согласовать представления о красоте оказалось совсем несложно. Мы договорились и отправились вперёд."}]]}]]}]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/novoe/04z.jpg","alt":"Фасад усадьбы со стороны сада: голубой дом с белой верандой, лестница и гараж справа","style":{"objectPosition":"center"}}],["$","div",null,{"children":[["$","h2",null,{"children":"Сам себе ансамбль."}],["$","p",null,{"children":"Два участка размежёваны стандартно, и ни на один по отдельности желаемый комплекс не помещался. Дом не ставили у дороги, а сместили глубже: с улицы остаются въезд и гараж в деревьях, при въезде скользим вдоль фасада и смотрим вдаль — на пойму, на барабаны и луковицы. К границам дом не привязан ортогонально: его развернули по рельефу. Пятно застройки легло по диагонали, и получились три уровня. Верхний — с большим уклоном, средний выровнен, здесь дом и сад, нижний — террасы и дорожки к пойме. Один фасад на восход, другой на закат, раскрытие на юг."}]]}]]}],["$","div",null,{"className":"pp-pair","children":[["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/novoe/02.jpg","alt":"Длинный деревянный фасад усадьбы: навес на колоннах и гараж слева"}],["$","figcaption",null,{"children":"Навес у въезда — крытый каретный подъезд."}]]}],["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/novoe/05.jpg","alt":"Боковой фасад усадьбы на закате: терраса и балкон над ней","style":{"objectPosition":"center 46%"}}],["$","figcaption",null,{"children":"Терраса на закат держит балкон мастер-спальни."}]]}]]}],"$L10","$L11","$L12","$L13"]}]
10:["$","section",null,{"className":"pp-moves","children":[["$","article",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Два участка не сливали"}],["$","p",null,{"children":"Межевание пересмотрели под посадку дома и сохранили отступы и плотность. Без объединения остались две точки подключения: дом на одном участке, гостевой дом с хозпостройками на другом."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Цену считают по нашим чертежам"}],["$","p",null,{"children":"Подрядчики не открывали узлы, и выбрать строителя по таким ценам было нельзя. Рабочий проект конструкции и инженерии сделали мы: цену уточняют по нему, монтажный проект его повторяет."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Стена из сухого бруса"}],["$","p",null,{"children":"Только сухой строганый брус, без клея, без ОСП и фанеры. Состав стены задали по финским каркасным требованиям: от него считают цену, а не от обобщённого предложения."}]]}]]}]
11:["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Что сделали"}],["$","p",null,{"children":"Собрали посадку участка, облик дома и рабочую документацию."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Сейчас"}],["$","p",null,{"children":"Проект 2024 года. 500 м², два этажа, пять комнат."}]]}]]}]
12:["$","section",null,{"className":"pp-products","children":[["$","p",null,{"className":"pp-kicker","children":"Из чего собрана эта работа"}],["$","div",null,{"children":[["$","a","Предпроектный анализ частных владений",{"href":"/site-AB-IM/mihail/napravleniya/houses/estate-analysis","children":[["$","span",null,{"children":"Архитектор"}],["$","strong",null,{"children":"Предпроектный анализ частных владений"}]]}],["$","a","Мастер-планирование частных владений",{"href":"/site-AB-IM/mihail/napravleniya/houses/estate-masterplan","children":[["$","span",null,{"children":"Архитектор"}],["$","strong",null,{"children":"Мастер-планирование частных владений"}]]}],["$","a","Архитектурно-градостроительный облик частных владений",{"href":"/site-AB-IM/mihail/napravleniya/houses/estate-ago","children":[["$","span",null,{"children":"Архитектор"}],["$","strong",null,{"children":"Архитектурно-градостроительный облик частных владений"}]]}],["$","a","ТЗ на проектирование частного дома",{"href":"/site-AB-IM/mihail/napravleniya/houses/estate-brief","children":[["$","span",null,{"children":"Архитектор"}],["$","strong",null,{"children":"ТЗ на проектирование частного дома"}]]}],["$","a","Эскизная концепция",{"href":"/site-AB-IM/mihail/bureau/uslugi/sketch","children":[["$","span",null,{"children":"Бюро"}],["$","strong",null,{"children":"Эскизная концепция"}]]}],["$","a","Рабочая документация — стадия Р",{"href":"/site-AB-IM/mihail/bureau/uslugi/stage-r","children":[["$","span",null,{"children":"Бюро"}],["$","strong",null,{"children":"Рабочая документация — стадия Р"}]]}],["$","a","ТЭО — подбор и комплектация",{"href":"/site-AB-IM/mihail/bureau/uslugi/feasibility","children":[["$","span",null,{"children":"Бюро"}],["$","strong",null,{"children":"ТЭО — подбор и комплектация"}]]}]]}]]}]
