1:["$","main",null,{"id":"content","className":"inner-page pp pp-saburovo","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/saburovo/01.jpg","alt":"Сабурово Клаб сверху: дома среди сосен"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Заказчик · Красногорск"}],["$","h1",null,{"children":"Сабурово Клаб"}],["$","p",null,{"className":"pp-hero-quote","children":"— Лес остаётся. Дома встают в него."}]]}]]}],["$","section",null,{"className":"talk-band","children":["$","aside",null,{"className":"service-lead-aside service-lead-stack talk-slot","children":[["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/saburovo/01.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","blockquote",null,{"children":"Сабурово: сто тридцать четыре дома в соснах. Посадили каждый на свой участок. Воду собрали в резервуар и отдали насосом, двадцать литров в секунду. Четыре года вместе со стройкой."}]]}]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"14 га · 134 дома · 10 км от Москвы"}],["$","h2",null,{"children":"Клубный посёлок в сосновом лесу."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"Для федерального девелопера это новый продукт: дом как квартира, только на своей земле. Типология была готова заранее, и от неё нельзя было отступать — на ней стоят экономика и кредит. Парк на трети земли собирала студия Verto."}],["$","p",null,{"children":"Бюро взяло рабочую документацию генплана и шло вместе со стройкой четыре года, с 2022-го. Расстановка домов, вертикальная планировка, проезды и вода. Как внутренний офис застройщика, а не альбом, который сдали и забыли."}]]}]]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/saburovo/02.jpg","alt":"План вертикальной планировки: посадка домов и въездная группа"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Посадка"}],["$","h2",null,{"children":"Не рисовать посёлок заново."}],["$","p",null,{"children":"Дома и межевание пришли готовыми. Каждый дом посадили на свой участок. Где тип не вставал, убирали навес, а не ломали участок и не меняли продукт."}]]}]]}],["$","section",null,{"className":"sab-figures","aria-label":"Проезды и вода","children":[["$","article",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Проезды"}],["$","svg",null,{"viewBox":"0 0 320 120","aria-hidden":"true","children":[["$","rect",null,{"x":"16","y":"28","width":"200","height":"36","fill":"#e7e4dc"}],["$","rect",null,{"x":"16","y":"64","width":"200","height":"22","fill":"#70a549"}],["$","path",null,{"d":"M24 46h184","stroke":"#16171b","strokeWidth":"1.5"}],["$","path",null,{"d":"M24 34v24M208 34v24","stroke":"#16171b","strokeWidth":"1"}],["$","text",null,{"x":"116","y":"22","textAnchor":"middle","fill":"#3d6b34","children":"3–4 м"}],["$","text",null,{"x":"236","y":"52","fill":"#16171b","children":"кольцо"}],["$","text",null,{"x":"236","y":"80","fill":"#3d6b34","children":"бульвар"}]]}],["$","p",null,{"children":"Ширину считали в створе машины и пожарной техники: каждый вариант от 3 до 4 метров. Одностороннее движение и кольца сузили проезжую часть. Освободившуюся землю отдали озеленению — в посёлке несколько бульваров."}]]}],["$","article",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Вода"}],["$","svg",null,{"viewBox":"0 0 320 120","aria-hidden":"true","children":[["$","rect",null,{"x":"16","y":"36","width":"70","height":"48","fill":"none","stroke":"#16171b"}],["$","path",null,{"d":"M28 68c14-16 28-16 42 0","fill":"none","stroke":"#3d6b34","strokeWidth":"1.5"}],["$","path",null,{"d":"M86 60h36","stroke":"#16171b","markerEnd":"url(#sab-arrow)"}],["$","rect",null,{"x":"122","y":"28","width":"78","height":"64","fill":"#e7e4dc","stroke":"#16171b"}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}],"$L18"]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d"]}]
