1:["$","main",null,{"id":"content","className":"inner-page pp pp-saburovo","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/saburovo/01.jpg","alt":"Сабурово Клаб сверху: дома среди сосен"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Заказчик · Красногорск"}],["$","h1",null,{"children":"Сабурово Клаб"}],["$","p",null,{"className":"pp-hero-quote","children":"— Лес остаётся. Дома встают в него."}]]}]]}],["$","section",null,{"className":"talk-band","children":["$","aside",null,{"className":"service-lead-aside service-lead-stack talk-slot","children":[["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/saburovo/01.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","blockquote",null,{"children":[["$","p","Сабурово: сто тридцать четыре дома в соснах. Сложный, крупный и интересный проект. Нашей задачей было посадить уже спроектированные дома каждый на свой участок и своими решениями подчеркнуть общий замысел. Как и в любом масштабном проекте, здесь за общей красотой скрывается миллион мелочей, но в итоге получился удобный и красивый посёлок с продуманной эстетикой, логистикой, инженерией и высоким качеством жизни.",{"children":"Сабурово: сто тридцать четыре дома в соснах. Сложный, крупный и интересный проект. Нашей задачей было посадить уже спроектированные дома каждый на свой участок и своими решениями подчеркнуть общий замысел. Как и в любом масштабном проекте, здесь за общей красотой скрывается миллион мелочей, но в итоге получился удобный и красивый посёлок с продуманной эстетикой, логистикой, инженерией и высоким качеством жизни."}]]}]]}]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"14 га · 134 дома · 10 км от Москвы"}],["$","h2",null,{"children":"Клубный посёлок в сосновом лесу."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":["Для федерального девелопера это новый продукт: дом как квартира, только на своей земле. Типология была готова заранее, и от неё нельзя было отступать — на ней стоят экономика и кредит. Парк на трети земли собирала ",["$","a",null,{"className":"pp-ext","href":"https://verto.ru/","target":"_blank","rel":"noreferrer","children":"студия Verto"}],"."]}],["$","p",null,{"children":"Бюро взяло рабочую документацию генплана и шло вместе со стройкой четыре года, с 2022-го. Расстановка домов, вертикальная планировка, проезды, логистика, стоки и прочее. На время строительства мы стали будто бы внутренней командой застройщика, постоянно работали на месте, в процессе — это был классный и очень вдохновляющий опыт для нас."}]]}]]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/saburovo/02.jpg","alt":"План вертикальной планировки: посадка домов и въездная группа"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Посадка"}],["$","h2",null,{"children":"Не рисовать посёлок заново."}],["$","p",null,{"children":"Дома и межевание пришли готовыми. Каждый дом посадили на свой участок. Нередко дом не вставал или ломалась общая эстетика — приходилось проектировать локальные изменения и доработки."}]]}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/saburovo/01.jpg","alt":"Въезд и петля дороги среди леса"}],["$","div",null,{"children":["$L10","$L11"]}]]}],"$L12","$L13","$L14"]}]
10:["$","h2",null,{"children":"Красногорск · 14 га · 134 участка · с 2022 · четыре года · построено"}]
11:["$","p",null,{"children":"Чертежи водоснабжения и канализации собраны по ГОСТ: аксонометрии с углами и привязками, чтобы не доделывать на месте. Один подрядчик закрыл рабочую документацию, гидравлику, подбор насосной, эскиз проездов и расстановку домов."}]
12:["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Заказчик"}],["$","p",null,{"children":["ФСК. Продуктовая карта и типология домов были до нас. Парк — ",["$","a",null,{"className":"pp-ext","href":"https://verto.ru/","target":"_blank","rel":"noreferrer","children":"студия Verto"}],"."]}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Бюро"}],["$","p",null,{"children":"Стадия Р и сопровождение. Посадка, проезды, вертикальная планировка, гидравлика."}]]}]]}]
