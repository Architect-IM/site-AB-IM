1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0387.jpg","alt":"Фабрика «Покровский пряник» в Нагорном"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Заказчик · Нагорный"}],["$","h1",null,{"children":"Покровский пряник"}],["$","p",null,{"className":"pp-hero-quote","children":"— Печатный пряник, который стал местом."}]]}]]}],["$","section",null,{"className":"talk-band","children":["$","aside",null,{"className":"service-lead-aside service-lead-stack talk-slot","children":[["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0356.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","blockquote",null,{"children":"Покровский пряник начался с двух деревянных форм. Сейчас это место: пряник, шоколадная фабрика и люди, которые приезжают сюда каждую неделю. Наша работа — чтобы это место читалось ещё до вывески."}]]}]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"1998 — сегодня"}],["$","h2",null,{"children":"От двух форм до шоколадной фабрики."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"В 1998 году местный предприниматель Виктор Геннадьевич Вахлин вырезал из дерева две формы — петушка и самовара — и собрал пряник, которого раньше в Покрове никогда не пекли: варёная сгущёнка и грецкий орех. Так с 2000 года Покровский пряник стал местом, брендом и патентом одновременно."}],["$","p",null,{"children":"Сначала было три человека, ручной замес и бытовые печи. Сегодня на предприятии пряники пекут, расписывают и глазируют десятки людей. Кроме того, сейчас здесь спроектирована, построена и работает шоколадная фабрика — уникальный производственно-туристический комплекс, который еженедельно собирает сотни туристов на обзорные экскурсии и мастер-классы."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0313.jpg","alt":"Ирина Михейкина с пряником в фирменном магазине"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"В работе над шоколадной фабрикой я специально не стала прятать, что это было овощехранилище. Детям лучше знать, чем здание было, чем получить новый фасад без памяти и истории. Кирпич, металл и бетон оставили на виду. Лофт и сложная расстекловка — чтобы место читалось, а не маскировалось."}]]}]]}],["$","$L10",null,{"photos":[{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0350.jpg","alt":"Фасад шоколадной фабрики"},{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0276.jpg","alt":"Зал фабрики: часы, лестница, витрина"},{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0334.jpg","alt":"Шоколадные фонтаны"},{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0323.jpg","alt":"Корпус на территории, вид сквозь сосны"},{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0359.jpg","alt":"Настил среди берёз"}]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0361.jpg","alt":"Фасад шоколадной фабрики"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Маршрут уже есть"}],"$L11","$L12"]}]]}],"$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a"]}]
:HL["/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0372.jpg","image"]
:HL["/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0415.jpg","image"]
11:["$","h2",null,{"children":"От пряника к шоколаду — пешком."}]
12:["$","p",null,{"children":"«Пряничная сказка» с 2016 года приняла больше ста тысяч человек. Группа выходит от главного пряничного цеха к шоколадной по парковому маршруту, специальному настилу, через берёзы. Внутри гости проходят по специальному маршруту, за стеклом, смотрят на работу цеха сверху, не останавливая его работу. Скоро здесь будет парк, площадка и главная сцена — проекты уже в работе."}]
13:["$","div",null,{"className":"pp-pair","children":[["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0372.jpg","alt":"Пешеходный настил паркового маршрута"}],["$","figcaption",null,{"children":"Настил паркового маршрута"}]]}],["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0415.jpg","alt":"Лесная тропа на территории"}],["$","figcaption",null,{"children":"Тропа, с которой начнётся парк"}]]}]]}]
14:["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Бывшее овощехранилище. Теперь шоколадная фабрика."}],["$","p",null,{"className":"pp-facts","children":"Нагорный · 830 м² · 2023 · работает"}]]}]
15:["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0356.jpg","alt":"Кирпичный корпус шоколадной фабрики"}],["$","div",null,{"children":[["$","p",null,{"children":"Половина здания была закрыта: аварийные конструкции, снаружи вид катакомб. В другой половине уже готовили конфеты. Нужно было быстро обследовать, починить и не трогать несущие конструкции. Вписать туристов в действующее производство. Добавить мастер-классы, магазин, кафе и другую необходимую инфраструктуру. Развести путь гостя и путь персонала. Вот уже три года проект работает и набирает обороты — по-моему получилось хорошо!"}],["$","p",null,{"className":"pp-line","children":"— Увидели не руины, а возможности."}]]}]]}]
16:["$","section",null,{"className":"pp-moves","children":[["$","article",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Не спрятали"}],["$","p",null,{"children":"Кирпич и металл остались. Дети могут понять, чем здание было. Окна — иллюминаторы в цех или витраж к производству. Лофт и расстекловка держат память места, а не рисуют новый фасад поверх."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Кольцо для гостя"}],["$","p",null,{"children":"В небольшом объёме маршрут проходит производство по шагам и не сталкивается с персоналом. Рядом — магазин и кафе. Насыпи вокруг старого корпуса становятся игровой геопластикой."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Территория дальше здания"}],["$","p",null,{"children":"Экотропа уже работает. Дальше — детская площадка и сцена с амфитеатром. Фабрика собирает центр детского творчества внутри развития Нагорного, в стороне от дороги."}]]}]]}]
17:["$","$L10",null,{"photos":[{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0366.jpg","alt":"Уличный настил у шоколадной фабрики"},{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0396.jpg","alt":"Вход пряничной фабрики с площади"},{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0300.jpg","alt":"Фирменный магазин «Покровский пряник»"},{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0413.jpg","alt":"Парк: вид с настила через берёзы"},{"src":"/site-AB-IM/mihail/assets/portfolio/pokrovskiy-pryanik/img_0407.jpg","alt":"Домик в парке среди берёз"}]}]
18:["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Архитектор"}],["$","p",null,{"children":"Мастер-план территории и мастер-план живого туристического объекта. Место, куда возвращаются, а не точка на чужом маршруте."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Бюро"}],["$","p",null,{"children":"Обследование, рабочая документация и функция технического заказчика. Технические решения при небольшом бюджете, без лишней перестройки."}]]}]]}]
