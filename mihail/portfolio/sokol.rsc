1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/sokol/01.jpg","alt":"Вход гостиницы «Сокол»"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Гостиница · Сокол"}],["$","h1",null,{"children":"Гостиница сокол"}],["$","p",null,{"className":"pp-hero-quote","children":["— ","Фасад, который снова можно назвать входом."]}]]}]]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"Сокол"}],["$","h2",null,{"children":"Ремонт фасада — это тоже архитектура."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"«Сокол» — существующая гостиница. Работа здесь не новый корпус, а фасад: вход, имя на портале, двор перед машиной, вечерний свет."}],["$","p",null,{"children":"Днём это светлый каменный объём и деревья. Вечером вход становится понятным издали. Имя гостиницы снова читается."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/sokol/02.jpg","alt":"Дневной фасад"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"Фасад часто чинят как отделку: заменить плитку и повесить вывеску. Я смотрю иначе. Вход должен объяснять дом. Портал, свет, двор перед ним — это и есть ремонт, если после него человек понимает, куда вошёл."}]]}]]}],null,["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/sokol/04.jpg","alt":"Вечерний двор"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"День и вечер"}],["$","h2",null,{"children":"Одно и то же здание, два состояния."}],["$","p",null,{"children":"Дневные кадры держат камень, деревья и подъезд. Вечерние — портал и имя. Фасад не перерисован в другой стиль. Он собран заново в том, который у него уже был."}]]}]]}],["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Ремонт фасадов."}],["$","p",null,{"className":"pp-facts","children":"Сокол · существующее здание · проект"}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/sokol/03.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"children":"Не строить рядом новое. Вернуть вход, имя и двор существующей гостинице так, чтобы она снова выглядела целой."}],["$","p",null,{"className":"pp-line","children":["— ","Здание осталось. Вход у него появился."]}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article","Портал",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Портал"}],["$","p",null,{"children":"Имя «Сокол» стоит на входе, а не на растяжке у дороги."}]]}],["$","article","Двор",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Двор"}],["$","p",null,{"children":"Подъезд и деревья делают передышку перед дверью."}]]}],["$","article","Вечер",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Вечер"}],["$","p",null,{"children":"Свет показывает вход, не всю стену разом."}]]}]]}],["$","a",null,{"className":"next-project","href":"/site-AB-IM/mihail/portfolio/hatminki","children":[["$","span",null,{"className":"section-label","children":"Следующий проект"}],["$","span",null,{"children":"Хатминки-Клаб"}],["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/hatminki/01.jpg","alt":"","loading":"lazy"}]]}]]}]
