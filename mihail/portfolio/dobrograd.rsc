io","className":"text-link","children":"Перейти в портфолио"}]]}]}],"children":["$","$Le",null,{"children":["$","$Lf",null,{"children":[["$","$Lb",null,{"providerId":"page:/portfolio/dobrograd","segmentMap":{"children":["__PAGE__"]},"children":["$","$Lc",null,{"id":"page:/portfolio/dobrograd"}]}],null]}]}]}]}]}]}]}]}],null,null]
