1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/monastyr/01.jpg","alt":"Главный храм"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Монастырь"}],["$","h1",null,{"children":"Монастырь"}],["$","p",null,{"className":"pp-hero-quote","children":["— ","Храм, кельи и гостиница — один двор."]}]]}]]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"Монастырь"}],["$","h2",null,{"children":"Не один купол. Целое хозяйство."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"Монастырь здесь — не открытка с храмом. Есть главный храм с синей главой, звонница, братские кельи, гостиница, баня, мастерские."}],["$","p",null,{"children":"План показывает, как это лежит на земле: дороги, дворы, огороды. Храм стоит в системе, а не на пустой лужайке."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/monastyr/02.jpg","alt":"Храм и кельи"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"Храм легко нарисовать отдельно и забыть, что в монастыре живут. Мне нужен двор, путь, келья, место для гостя. Купол тогда не украшение кадра, а центр хозяйства."}]]}]]}],null,["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/monastyr/04.jpg","alt":"Гостиница"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Хозяйство"}],["$","h2",null,{"children":"Гостиница не спорит с храмом."}],["$","p",null,{"children":"Гостиница и кельи — деревянные, ниже храма, с обычными кровлями. Они не копируют церковный декор. Они держат быт и оставляют храму высоту."}]]}]]}],["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Монастырский комплекс."}],["$","p",null,{"className":"pp-facts","children":"Храм · кельи · гостиница · проект"}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/monastyr/03.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"children":"Собрать храм, звонницу, жильё и мастерские в один план. Чтобы гость шёл по двору, а не по набору отдельных картинок."}],["$","p",null,{"className":"pp-line","children":["— ","Священное стоит в центре. Жизнь — вокруг, и она тоже спроектирована."]}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article","Храм",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Храм"}],["$","p",null,{"children":"Высота и глава остаются за ним. Остальные корпуса ниже."}]]}],["$","article","Жильё",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Жильё"}],["$","p",null,{"children":"Кельи и гостиница говорят деревом, не цитатой купола."}]]}],["$","article","План",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"План"}],["$","p",null,{"children":"Дороги и дворы связывают хозяйство в одно место."}]]}]]}],["$","a",null,{"className":"next-project","href":"/site-AB-IM/mihail/portfolio/balyaga","children":[["$","span",null,{"className":"section-label","children":"Следующий проект"}],["$","span",null,{"children":"Баляга"}],["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/balyaga/01.jpg","alt":"","loading":"lazy"}]]}]]}]
