1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/kabardinka/01.jpg","alt":"Въезд гостиницы"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Гостиница · Кабардинка"}],["$","h1",null,{"children":"Гостиница Кабардинка"}],["$","p",null,{"className":"pp-hero-quote","children":["— ","Гостиница, которую сначала читаешь со въезда."]}]]}]]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"Кабардинка"}],["$","h2",null,{"children":"Сначала навес. Потом номер."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"Кабардинка собирается не с фасада номера, а со въезда. Широкая кровля, вывеска, вода у порога, горы за спиной. Гость понимает, куда приехал, ещё не дойдя до ресепшена."}],["$","p",null,{"children":"Дальше двор, длинные корпуса, бассейн на кровле и ресторан с видом. Это один маршрут, не набор картинок."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/kabardinka/02.jpg","alt":"Двор"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"Большую гостиницу легко развалить на «корпус А» и «корпус Б». Здесь я держу один жест: навес въезда, двор и вода. Номера могут быть длинными. Вход должен быть один и ясный."}]]}]]}],null,["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/kabardinka/04.jpg","alt":"Внутренний бассейн"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Двор и вода"}],["$","h2",null,{"children":"Бассейн — не приложение к номеру."}],["$","p",null,{"children":"Открытый бассейн лежит на кровле и смотрит в горы. Внутренний — уже тихий, с деревом и камнем. Ресторан продолжает ту же кровлю. Гость не ищет «зону спа» по указателю."}]]}]]}],["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Гостиница как маршрут."}],["$","p",null,{"className":"pp-facts","children":"Кабардинка · горы · проект"}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/kabardinka/03.jpg","alt":""}],["$","div",null,{"children":[["$","p",null,{"children":"Въезд, двор, бассейн, внутренний бассейн, ресторан, интерьер. Всё это один комплекс. Задача — чтобы длинные корпуса не съели место, с которого гостиница вообще начинается."}],["$","p",null,{"className":"pp-line","children":["— ","Приехал — и сразу понял, где ты."]}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article","Въезд",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Въезд"}],["$","p",null,{"children":"Навес и вода встречают раньше, чем стойка."}]]}],["$","article","Двор",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Двор"}],["$","p",null,{"children":"Корпуса стоят по краю, середина остаётся людям."}]]}],["$","article","Кровля",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Кровля"}],["$","p",null,{"children":"Бассейн и ресторан смотрят наружу, не во двор колодцем."}]]}]]}],["$","a",null,{"className":"next-project","href":"/site-AB-IM/mihail/portfolio/altai","children":[["$","span",null,{"className":"section-label","children":"Следующий проект"}],["$","span",null,{"children":"Гостиница Алтай"}],["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/altai/01.jpg","alt":"","loading":"lazy"}]]}]]}]
