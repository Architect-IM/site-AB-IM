12:["$","section",null,{"className":"pp-moves","children":[["$","article",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Приёмы отдельно"}],["$","p",null,{"children":"Кабинет со своим крыльцом со стороны усадьбы. Хозяин входит с улицы и не проходит через комнаты гостей."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Четыре комнаты"}],["$","p",null,{"children":"Изолированные, как просторные номера. В другую сторону от холла — гостиная со столовой и камином, и у неё свой вход."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Персонал своим ходом"}],["$","p",null,{"children":"Кухня, с которой накрывают стол, черновая кухня и загрузка не идут через гостиную. Из гостиной короткий выход во двор, к основной усадьбе."}]]}]]}]
13:["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Архитектор"}],["$","p",null,{"children":"Концепция приёмного дома. Фасад держит деревянную традицию Плёса, план разводит приёмы, гостей и персонал."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Сейчас"}],["$","p",null,{"children":"Концепция, 2021. В стройку не ушла. Пока)"}]]}]]}]
