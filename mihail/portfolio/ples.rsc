1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/ples/winter.jpg","alt":"Приёмный дом в Плёсе зимой: резные наличники и несколько объёмов"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Плёс · 2021"}],["$","h1",null,{"children":"дом Плес"}],["$","p",null,{"className":"pp-hero-quote","children":"— Приёмный дом усадьбы."}]]}]]}],["$","section",null,{"className":"talk-band","children":["$","aside",null,{"className":"service-lead-aside service-lead-stack talk-slot","children":[["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/ples/winter.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","blockquote",null,{"children":[["$","p","Нас позвали, когда чужие эскизы не проходили: тяжёлое шале, дом выглядел второстепенным. Места мы не видели, всё было со слов строителя, и срок — три дня. Вместо шале собрали русский двор, как в Плёсе. Эскиз понравился. В стройку он не пошёл, зато потом был чайный домик.",{"children":"Нас позвали, когда чужие эскизы не проходили: тяжёлое шале, дом выглядел второстепенным. Места мы не видели, всё было со слов строителя, и срок — три дня. Вместо шале собрали русский двор, как в Плёсе. Эскиз понравился. В стройку он не пошёл, зато потом был чайный домик."}]]}]]}]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/ples/summer.jpg","alt":"Летний вид: несколько деревянных объёмов и двор между ними"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Образ"}],["$","h2",null,{"children":"Не шале. Русский двор."}],["$","p",null,{"children":"Одноэтажный дом у Волги, Г-образный. Снаружи лиственница, скатные кровли и резьба Плёса. Внутри современный план: комнаты, общая гостиная и отдельный вход хозяина."}]]}]]}],["$","div",null,{"className":"pp-pair","children":[["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/ples/porch.jpg","alt":"Крыльцо с видом в сад"}],["$","figcaption",null,{"children":"Крыльцо"}]]}],["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/mihail/assets/portfolio/ples/plan.jpg","alt":"План: спальни, гостиная и блок персонала с разными входами"}],["$","figcaption",null,{"children":"Гости, хозяин и персонал не встречаются"}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Три дня"}],["$","p",null,{"children":"Площадку не видели: всё со слов строителя. План собрали за сутки, фасады и картинку — на следующий день."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Три входа"}],["$","p",null,{"children":"Гости живут в своих комнатах. Хозяин входит в кабинет со стороны усадьбы. У персонала свой вход, кухня и загрузка."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Фасад и план"}],["$","p",null,{"children":"Снаружи традиционный деревянный дом. Внутри блоки, а не один длинный прямоугольник: так фасад не становится тяжёлым."}]]}]]}],["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Архитектор"}],["$","p",null,{"children":"Частные владения и концепция. Эскиз смотрели как реализуемый и отмечали, что он ложится на усадьбу."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Сейчас"}],["$","p",null,{"children":"Концепция, 2021. Дом не построен. Дальше был чайный домик, со строительной компанией работа продолжается."}]]}]]}],"$L10","$L11"]}]
