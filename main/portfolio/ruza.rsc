1:["$","main",null,{"id":"content","className":"inner-page pp pp-ruza","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/main/assets/portfolio/ruza/01.jpg","alt":"Дом-дача в Рузе: резной деревянный фасад среди сосен"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Заказчик · Руза"}],["$","h1",null,{"children":"дом-дача в Рузе"}],["$","p",null,{"className":"pp-hero-quote","children":"— Дача отца. Мастерская сына."}]]}]]}],["$","section",null,{"className":"talk-band","children":["$","aside",null,{"className":"service-lead-aside service-lead-stack talk-slot","children":[["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/main/assets/portfolio/ruza/01.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","blockquote",null,{"children":[["$","p","В Рузе восстанавливали дачу отца владельца, известного художника. Первый этаж почти повторяет дом его детских каникул. Наверху — галерея работ отца и мастерская сына, с окнами в крыше.",{"children":"В Рузе восстанавливали дачу отца владельца, известного художника. Первый этаж почти повторяет дом его детских каникул. Наверху — галерея работ отца и мастерская сына, с окнами в крыше."}]]}]]}]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"2023 · Руза · 300 м²"}],["$","h2",null,{"children":"Сначала память дома. Потом новый фасад."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"Заказчик пришёл воссоздать старую дачу отца, известного художника. На втором этаже — мастерская, в которой теперь будет работать сын. Дальше территорию можно увеличить: новые дома в дачном духе, а этот дом станет домом-музеем. Жильё уйдёт в новые корпуса. Пока это начало."}],["$","p",null,{"children":"Первый этаж почти полностью повторяет планировку, в которой заказчик проводил детские каникулы. Сохранены виды, которые были дороги, и мебель стоит по прежним зонам. Веранда стала тёплой. Санузел больше, с душем, ещё один — на втором этаже. Камин крупнее, с изразцами. Появилась большая родительская комната."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/main/assets/portfolio/ruza/02.jpg","alt":"Гостиная дом-дачи: камин, диван и вид в сосны"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"Объём сложился из истории, поэтому искали фасад. Старую изломанную кровлю типичной дачи не хотелось копировать: она уже не держала эстетику. И не хотелось потерять дух места. Деревянный фасад с орнаментом: часть декора, часть прорезана окнами. Массив читается как витраж старой профессорской дачи и как садовый павильон."}]]}]]}],["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/main/assets/portfolio/ruza/01.jpg","alt":"Фасад дом-дачи с резными наличниками"}],["$","div",null,{"children":[["$","h2",null,{"children":"Руза · 300 м² · 3 этажа · 2 спальни · 2023 · концепция"}],["$","p",null,{"children":"Мансарда отдана галерее работ отца. Над мастерской — антресоль: уклон кровли дал место, и окна в крыше. Галерея и мастерская разделены. Заказчику важна была именно эта свободная галерея-мастерская. Проект остаётся концепцией: о стройке пока неизвестно."}]]}]]}],["$","section",null,{"className":"pp-moves","children":[["$","article",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Планировка детства"}],["$","p",null,{"children":"Первый этаж держит старый дом. Новые удобства не переписывают его: тёплая веранда, душ, изразцовый камин, комната хозяев."}]]}],"$L10","$L11"]}],"$L12","$L13","$L14"]}]
10:["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Витраж вместо дачной кровли"}],["$","p",null,{"children":"Орнамент и окна делают фасад ажурным. Это не копия изломанной крыши и не новый дом без памяти."}]]}]
11:["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Два этажа, две роли"}],["$","p",null,{"children":"Внизу жизнь семьи. Наверху галерея отца и мастерская сына. Позже дом может стать музеем, а жильё уйдёт в новые корпуса."}]]}]
12:["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Архитектор"}],["$","p",null,{"children":"Частные владения и концепция. Дом как память семьи и начало будущего музейного комплекса."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Сейчас"}],["$","p",null,{"children":"Концепция. В реализацию проект пока не передан."}]]}]]}]
