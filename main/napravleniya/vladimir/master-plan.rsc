10:["$","main",null,{"id":"content","className":"inner-page _page_11xvo_1","children":[["$","nav",null,{"className":"_breadcrumbs_11xvo_2","aria-label":"Навигация по разделу","children":[["$","a",null,{"href":"/site-AB-IM/main/napravleniya/vladimir#master-plan","children":"← Владимирский контекст"}],["$","span",null,{"className":"_eyebrow_11xvo_13","children":["01"," / 04"]}]]}],["$","header",null,{"className":"_detailIntro_11xvo_145","children":[["$","p",null,{"className":"_eyebrow_11xvo_13","children":"Владимирский контекст"}],["$","h1",null,{"children":"Мастер-план раскрытия потенциала территории"}],["$","p",null,{"className":"_detailLead_11xvo_156","children":"Фундаментальная работа с историей, культурой, ландшафтом и тем, что здесь реально возможно. Показываю не только допустимое по бумагам, а то, что будет сильным и уместным именно на этом месте."}]]}],["$","figure",null,{"className":"_detailImage_11xvo_157","children":["$","img",null,{"src":"/site-AB-IM/main/assets/territory.jpg","alt":"Панорама поселения на высоком берегу реки","fetchPriority":"high"}]}],["$","div",null,{"className":"_detailSections_11xvo_159","children":[[["$","section","Для кого и когда",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-0","children":[["$","h2",null,{"id":"section-0","children":"Для кого и когда"}],["$","p",null,{"children":"Для собственников, администраций и инвесторов, у которых есть земля и вопрос, что с ней делать дальше. Особенно когда участок сложный: наследие, рельеф, ограничения, ожидания города."}]]}],["$","section","Что в результате?",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-1","children":[["$","h2",null,{"id":"section-1","children":"Что в результате?"}],["$","p",null,{"children":"Основание для решений, с которым можно идти к инвесторам, в администрацию и к проектировщикам. Ясность: что усиливать, что не трогать, куда смотреть в первую очередь."}]]}],["$","section","Как работаем",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-2","children":[["$","h2",null,{"id":"section-2","children":"Как работаем"}],["$","p",null,{"children":"Собираю историю места, культурный слой, ландшафт и реальные возможности. Сверяю гипотезы с тем, что территория выдержит. Фиксирую выводы так, чтобы ими можно было пользоваться сразу."}]]}],["$","section","Почему это важно",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-3","children":[["$","h2",null,{"id":"section-3","children":"Почему это важно"}],["$","p",null,{"children":"Формально допустимое и по-настоящему сильное — разные вещи. Хороший мастер-план экономит годы споров, потому что заранее отделяет уместное от случайного."}]]}],["$","section","Формат и следующий шаг",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-4","children":[["$","h2",null,{"id":"section-4","children":"Формат и следующий шаг"}],["$","p",null,{"children":"Результат — мастер-план с логикой развития и понятными следующими шагами. После него обычно переходят к концепции, АГО или разговору с инвесторами."}]]}]],["$","a",null,{"className":"_link_11xvo_61","href":"/site-AB-IM/main/contacts?topic=%D0%9C%D0%B0%D1%81%D1%82%D0%B5%D1%80-%D0%BF%D0%BB%D0%B0%D0%BD%20%D1%80%D0%B0%D1%81%D0%BA%D1%80%D1%8B%D1%82%D0%B8%D1%8F%20%D0%BF%D0%BE%D1%82%D0%B5%D0%BD%D1%86%D0%B8%D0%B0%D0%BB%D0%B0%20%D1%82%D0%B5%D1%80%D1%80%D0%B8%D1%82%D0%BE%D1%80%D0%B8%D0%B8","children":["Обсудить задачу ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","nav",null,{"className":"_return_11xvo_143","aria-label":"Навигация по разделу","children":["$","a",null,{"className":"_link_11xvo_61","href":"/site-AB-IM/main/napravleniya/vladimir#master-plan","children":"← Владимирский контекст"}]}]]}]
