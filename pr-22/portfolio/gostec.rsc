1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/home-hospitality-gostec.jpg","alt":"Гостец: тёмные дома в тумане и лошади на лугу"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Деревня Гостец · 2024"}],["$","h1",null,{"children":"Гостиница Гостец"}],["$","p",null,{"className":"pp-hero-quote","children":"— Гостиничный мини-посёлок в настоящей деревне."}]]}]]}],["$","section",null,{"className":"talk-band","children":["$","aside",null,{"className":"service-lead-aside service-lead-stack talk-slot","children":[["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/gostec/01.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","blockquote",null,{"children":"Гостец — небольшая территория в лесу, у поймы Шередари. Вопрос был не в картинке, а в том, что удержит человека на три дня. Ресторан здесь нужен и своим, и тем, кто иначе проезжает Покров мимо."}]]}]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"Четырёхзвёздочный эко-отель"}],["$","h2",null,{"children":"Что может удержать на три дня."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"Небольшая территория в лесу, на окраине деревни Гостец, с видом на пойму реки Шередарь. Меньше гектара. Заказчику было ясно, что здесь будет ресторан, но не ясны мощность и технико-экономический потенциал. Ресторан и спа нужно было поставить так, чтобы их можно было обслуживать с его предприятия в двадцати минутах. Номера — не маленькие: родители с детьми и кровати кинг-сайз."}],["$","p",null,{"children":"Покров стоит на Золотом кольце, на дороге Москва — Владимир. Кто-то останавливается на двадцать минут, кто-то остаётся на несколько дней. Промышленный туризм в городе уже есть. Ресторана не хватает и для своих, а многие туристы проезжают мимо. Комплекс сохраняет имя деревни и опирается на её облик, а не на курорт, который мог бы стоять где угодно."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/gostec/04.jpg","alt":"Чёрное дерево фасада: доска, выгоревшая на солнце"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Ирина Михейкина"}],["$","p",null,{"children":"Чёрное дерево здесь не краска. Это цвет доски, которая выгорела на солнце, — тот материал, из которого в деревне и строили. Новые дома нужно вплести в место: старые домики, огороды, грунтовый подъезд, деревянные заборы. Не нарушить пространство и не потерять его."}]]}]]}],["$","$L10",null,{"photos":[{"src":"/site-AB-IM/pr-22/assets/portfolio/gostec/01.jpg","alt":"Гостец сверху: дома среди деревьев у поймы"},{"src":"/site-AB-IM/pr-22/assets/portfolio/gostec/02.jpg","alt":"Улица гостевых домов"},{"src":"/site-AB-IM/pr-22/assets/portfolio/gostec/night.jpg","alt":"Вечер: фонари и дома у поймы"},{"src":"/site-AB-IM/pr-22/assets/portfolio/gostec/03.jpg","alt":"Интерьер с видом на лес"},{"src":"/site-AB-IM/pr-22/assets/home-hospitality-gostec.jpg","alt":"Туман, луг и лошади перед домами"}]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/gostec/01.jpg","alt":"Посадка домов ближе к пойме, деревья остаются"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Территория"}],["$","h2",null,{"children":"Дома ближе к пойме. Деревья остаются."}],"$L11"]}]]}],"$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}]
:HL["/site-AB-IM/pr-22/assets/portfolio/gostec/02.jpg","image"]
:HL["/site-AB-IM/pr-22/assets/portfolio/gostec/night.jpg","image"]
11:["$","p",null,{"children":"Въезд с КПП и парковкой. Гостиница со спа на возвышении у входа: террасы спа в цоколе, кафе на первом этаже. Дальше — детская площадка на террасах склона, смотровые площадки, горки: зимой ватрушки, летом прогулка. Четыре гостевых дома на 6–12 человек, глэмпинг и рекреация с выходами в поле и лес. Летом — лес, вода и лошади. Зимой — коньки, лыжи, упряжки. Склон террасирован, чтобы рельеф читался, а не был срезан."}]
12:["$","div",null,{"className":"pp-pair","children":[["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/gostec/02.jpg","alt":"Гостевые дома на склоне"}],["$","figcaption",null,{"children":"Гостевые дома у склона"}]]}],["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/gostec/night.jpg","alt":"Дома и фонари вечером"}],["$","figcaption",null,{"children":"Вечер у поймы"}]]}]]}]
13:["$","section",null,{"className":"pp-turn","children":[["$","p",null,{"className":"pp-kicker","children":"Дальше — наша работа"}],["$","h2",null,{"children":"Мини-посёлок, а не один корпус в поле."}],["$","p",null,{"className":"pp-facts","children":"Гостец · 8500 м² · 3000 м² зданий · 70 номеров · 2024 · глэмпинг запущен"}]]}]
14:["$","section",null,{"className":"pp-work","children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/home-hospitality-gostec.jpg","alt":"Дома Гостеца в тумане"}],["$","div",null,{"children":[["$","p",null,{"children":"В центре — четыре гостевых дома. Соседние делят парящую террасу на опорах: открытый бассейн, баня, тропы вниз по склону. Линейка — студия, дом на три спальни и дом на четыре, у каждого блока свой бассейн. Коттедж снимают целиком, со всем отельным сервисом. Но каждая спальня сделана как номер: если нужно, дом работает как гостиница. Гостиница со спа стоит выше, у въезда, технические этажи уходят в склон, номера смотрят на восход. В ней сорок шесть человек при полной загрузке. Глэмпинг — а-фреймы на троих-четверых, с очагом на террасе. Его уже запустили. Остальное — на стадии реализации."}],["$","p",null,{"className":"pp-line","children":"— Имя деревни остаётся именем комплекса."}]]}]]}]
15:["$","section",null,{"className":"pp-moves","children":[["$","article",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Три дня"}],["$","p",null,{"children":"Не остановка на двадцать минут. Сначала данные: ресторан в Покрове нужен и своим, спа — тем, кто остаётся. У каждого направления заложена возможность роста."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Парящие дома"}],["$","p",null,{"children":"Корпуса сдвинуты к пойме, внутреннее пространство участка остаётся. Деревья не вырубают под площадку. Пойму занимают зимой и летом, а не оставляют видом из окна."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Дом или номер"}],["$","p",null,{"children":"Гость получает коттедж. Если загрузка другая — ту же спальню сдают как номер. Острые фронтоны на склоне собирают силуэт, чёрное дерево сажает дома в лес."}]]}]]}]
16:["$","section",null,{"className":"pp-two","children":[["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Архитектор"}],["$","p",null,{"children":"Живое гостеприимство и АГО. Место, которое держит человека дольше одной остановки, и облик, который ссылается на деревню."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Сейчас"}],["$","p",null,{"children":"Объект на стадии реализации. Глэмпинг из а-фреймов уже запущен."}]]}]]}]
