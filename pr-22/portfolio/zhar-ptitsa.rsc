1:["$","main",null,{"id":"content","className":"inner-page pp","children":[["$","section",null,{"className":"pp-hero","children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/evening.jpg","alt":"Банный комплекс на Истре вечером: терраса и бассейн"}],["$","div",null,{"className":"pp-hero-copy","children":[["$","p",null,{"className":"section-label","children":"Истра · 2025"}],["$","h1",null,{"children":"Жар-Птица"}],["$","p",null,{"className":"pp-hero-quote","children":"— Похожий модуль уже стоит. Нужен ещё один."}]]}]]}],["$","section",null,{"className":"talk-band","children":["$","aside",null,{"className":"service-lead-aside service-lead-stack talk-slot","children":[["$","figure",null,{"children":[["$","div",null,{"className":"lead-video","children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/evening.jpg","alt":""}],["$","button",null,{"type":"button","className":"lead-play","aria-disabled":"true","aria-label":"Видео ещё не снято","children":["$","svg",null,{"viewBox":"0 0 24 24","aria-hidden":"true","children":["$","path",null,{"d":"M9 6.8v10.4L18.2 12z"}]}]}]]}],["$","figcaption",null,{"className":"service-lead-sign","children":["Ирина Михейкина",["$","span",null,{"children":"архитектор"}]]}]]}],["$","blockquote",null,{"children":"На Новой Риге модуль «Жар-Птицы» уже стоит и сдаётся. На Истре нужен ещё один комплекс, на четыре блока. Архитектуру сделали с нуля, а самым сложным оказалась вода и тепло."}]]}]}],["$","section",null,{"className":"pp-open","children":[["$","p",null,{"className":"pp-kicker","children":"Bulldozer Group"}],["$","h2",null,{"children":"Четыре модуля за короткий срок."}],["$","div",null,{"className":"pp-open-grid","children":[["$","p",null,{"children":"На Новой Риге уже работает банный комплекс «Жар-Птица»: модуль стоит, спрос есть. Заказчику нужен ещё один комплекс, на четыре модуля, и полный проект — в максимально короткий срок. Площадь 850 м²."}],["$","p",null,{"children":"Кроме корпусов сразу закладывали инженерию. Газовая котельная от газгольдера, бюджетно. Анализ воды и система водоочистки. Всё это должно было поместиться в работу комплекса, который сдают между гостями быстро."}]]}]]}],["$","section",null,{"className":"pp-portrait","children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/existing.jpg","alt":"Действующий корпус «Жар-Птицы»"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Бюро"}],["$","p",null,{"children":"Архитектуру и конструкции сделали с нуля. Самым сложным оказалась инженерия: отопление и водоподготовка. К ним подключили партнёров. Потребителей много, скважина одна — и она уже кормит действующий комплекс."}]]}]]}],["$","$L10",null,{"photos":[{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/evening.jpg","alt":"Вечерний вид комплекса"},{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/garden.jpg","alt":"Озеленение вдоль террас"},{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/terrace.jpg","alt":"Терраса с бассейном"},{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/existing.jpg","alt":"Существующий корпус"}]}],["$","section",null,{"className":"pp-path","children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/garden.jpg","alt":"Террасы и посадки у банного комплекса"}],["$","div",null,{"children":[["$","p",null,{"className":"pp-kicker","children":"Вода"}],["$","h2",null,{"children":"Одна скважина на старый комплекс и новые бани."}],["$","p",null,{"children":"Водобаланс считали по всем расходам действующего комплекса. К общим нуждам новых бань добавилось обновление воды в холодной и горячей купелях. По анализу воды в той же котельной подобрали очистку для общего водоснабжения и фильтрацию для обеих купелей."}]]}]]}],["$","div",null,{"className":"pp-pair","children":[["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/terrace.jpg","alt":"Бассейн на террасе"}],["$","figcaption",null,{"children":"Терраса с бассейном"}]]}],["$","figure",null,{"children":[["$","img",null,{"src":"/site-AB-IM/pr-22/assets/portfolio/zhar-ptitsa/existing.jpg","alt":"Модуль, который уже работает"}],"$L11"]}]]}],"$L12","$L13","$L14","$L15","$L16"]}]
