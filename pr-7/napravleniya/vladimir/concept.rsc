10:["$","main",null,{"id":"content","className":"inner-page _page_11xvo_1","children":[["$","nav",null,{"className":"_breadcrumbs_11xvo_2","aria-label":"Навигация по разделу","children":[["$","a",null,{"href":"/site-AB-IM/pr-7/napravleniya/vladimir#concept","children":"← Владимирский контекст"}],["$","span",null,{"className":"_eyebrow_11xvo_13","children":["02"," / 04"]}]]}],["$","header",null,{"className":"_detailIntro_11xvo_145","children":[["$","p",null,{"className":"_eyebrow_11xvo_13","children":"Владимирский контекст"}],["$","h1",null,{"children":"Идеологическое и концептуальное проектирование"}],["$","p",null,{"className":"_detailLead_11xvo_156","children":"Сборка смысловой платформы объекта. Соединяю идеологию, архитектуру и экономику в одно решение, выдержанное по смыслу, контексту и реализуемости."}]]}],["$","figure",null,{"className":"_detailImage_11xvo_157","children":["$","img",null,{"src":"/site-AB-IM/pr-7/assets/territory.jpg","alt":"Рельеф, река и историческая застройка","fetchPriority":"high"}]}],["$","div",null,{"className":"_detailSections_11xvo_159","children":[[["$","section","Для кого и когда",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-0","children":[["$","h2",null,{"id":"section-0","children":"Для кого и когда"}],["$","p",null,{"children":"Для тех, у кого есть задача или участок, но ещё нет точной идеи, зачем этот объект здесь. Особенно когда «просто красиво» недостаточно."}]]}],["$","section","Что в результате?",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-1","children":[["$","h2",null,{"id":"section-1","children":"Что в результате?"}],["$","p",null,{"children":"Связную идеологическую платформу, а не набор картинок. Формулировку, с которой можно идти в АГО, к инвесторам и дальше в проектирование."}]]}],["$","section","Как работаем",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-2","children":[["$","h2",null,{"id":"section-2","children":"Как работаем"}],["$","p",null,{"children":"Формулирую идеологию объекта и связываю её с архитектурой и экономикой. Опираюсь на работу лаборатории «Владимир». Проверяю, выдерживает ли идея контекст и реализацию."}]]}],["$","section","Почему это важно",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-3","children":[["$","h2",null,{"id":"section-3","children":"Почему это важно"}],["$","p",null,{"children":"Поверхностная идея рассыпается на согласованиях и в смете. Глубокая концепция экономит дальнейшую работу: все решения растут из одной платформы."}]]}],["$","section","Формат и следующий шаг",{"className":"_detailSection_11xvo_159","aria-labelledby":"section-4","children":[["$","h2",null,{"id":"section-4","children":"Формат и следующий шаг"}],["$","p",null,{"children":"Концептуальный документ с идеологией, образом и логикой развития. Затем АГО, объёмно-планировочные решения или мастер-план."}]]}]],["$","a",null,{"className":"_link_11xvo_61","href":"/site-AB-IM/pr-7/contacts?topic=%D0%98%D0%B4%D0%B5%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%BE%D0%B5%20%D0%B8%20%D0%BA%D0%BE%D0%BD%D1%86%D0%B5%D0%BF%D1%82%D1%83%D0%B0%D0%BB%D1%8C%D0%BD%D0%BE%D0%B5%20%D0%BF%D1%80%D0%BE%D0%B5%D0%BA%D1%82%D0%B8%D1%80%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5","children":["Обсудить задачу ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","nav",null,{"className":"_return_11xvo_143","aria-label":"Навигация по разделу","children":["$","a",null,{"className":"_link_11xvo_61","href":"/site-AB-IM/pr-7/napravleniya/vladimir#concept","children":"← Владимирский контекст"}]}]]}]
